{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/case/v1/case-lifecycle.schema.json",
  "title": "COH case lifecycle v1",
  "oneOf": [
    {"$ref": "#/$defs/command"},
    {"$ref": "#/$defs/authorization_request"},
    {"$ref": "#/$defs/decision"},
    {"$ref": "#/$defs/record"},
    {"$ref": "#/$defs/receipt"}
  ],
  "$defs": {
    "case": {
      "type": "object",
      "required": ["organization_id", "tenant_id", "case_id"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/uuid_v7"},
        "tenant_id": {"$ref": "#/$defs/uuid_v7"},
        "case_id": {"$ref": "#/$defs/uuid_v7"}
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "schema_version", "contract_version", "request_id", "idempotency_key",
        "operation", "case", "actor_id", "actor_revision", "target_classification",
        "assignee_actor_id", "retention_policy_id", "retain_until", "reason_digest",
        "export_manifest_digest", "policy_digest", "expected_revision", "deadline"
      ],
      "properties": {
        "schema_version": {"const": "coh.case-command/v1"},
        "contract_version": {"const": "1.0.0"},
        "request_id": {"$ref": "#/$defs/uuid_v7"},
        "idempotency_key": {"$ref": "#/$defs/opaque"},
        "operation": {"$ref": "#/$defs/operation"},
        "case": {"$ref": "#/$defs/case"},
        "actor_id": {"$ref": "#/$defs/uuid_v7"},
        "actor_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "target_classification": {"$ref": "#/$defs/optional_classification"},
        "assignee_actor_id": {"$ref": "#/$defs/optional_uuid_v7"},
        "retention_policy_id": {"$ref": "#/$defs/optional_uuid_v7"},
        "retain_until": {"$ref": "#/$defs/optional_timestamp"},
        "reason_digest": {"$ref": "#/$defs/optional_digest"},
        "export_manifest_digest": {"$ref": "#/$defs/optional_digest"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "expected_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "deadline": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "authorization_request": {
      "type": "object",
      "required": [
        "schema_version", "contract_version", "authorization_digest", "intent_digest",
        "command", "current_state", "current_classification", "current_assignee_actor_id",
        "current_legal_hold", "current_retain_until", "current_provenance_digest"
      ],
      "properties": {
        "schema_version": {"const": "coh.case-authorization/v1"},
        "contract_version": {"const": "1.0.0"},
        "authorization_digest": {"$ref": "#/$defs/digest"},
        "intent_digest": {"$ref": "#/$defs/digest"},
        "command": {"$ref": "#/$defs/command"},
        "current_state": {"$ref": "#/$defs/optional_state"},
        "current_classification": {"$ref": "#/$defs/optional_classification"},
        "current_assignee_actor_id": {"$ref": "#/$defs/optional_uuid_v7"},
        "current_legal_hold": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
        "current_retain_until": {"$ref": "#/$defs/optional_timestamp"},
        "current_provenance_digest": {"$ref": "#/$defs/optional_digest"}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "schema_version", "contract_version", "decision_id", "decision_digest",
        "authorization_digest", "intent_digest", "operation", "case", "actor_id",
        "actor_revision", "expected_revision", "policy_digest", "revocation_digest",
        "outcome", "reason_code", "issued_at", "expires_at", "revision"
      ],
      "properties": {
        "schema_version": {"const": "coh.case-decision/v1"},
        "contract_version": {"const": "1.0.0"},
        "decision_id": {"$ref": "#/$defs/uuid_v7"},
        "decision_digest": {"$ref": "#/$defs/digest"},
        "authorization_digest": {"$ref": "#/$defs/digest"},
        "intent_digest": {"$ref": "#/$defs/digest"},
        "operation": {"$ref": "#/$defs/operation"},
        "case": {"$ref": "#/$defs/case"},
        "actor_id": {"$ref": "#/$defs/uuid_v7"},
        "actor_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "expected_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "revocation_digest": {"$ref": "#/$defs/digest"},
        "outcome": {"enum": ["allow", "deny"]},
        "reason_code": {"$ref": "#/$defs/token"},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "schema_version", "contract_version", "case", "creator_actor_id", "owner_actor_id",
        "assignee_actor_id", "classification", "state", "retention_policy_id", "retain_until",
        "legal_hold", "hold_reason_digest", "last_export_manifest_digest", "export_count",
        "deletion_reason_digest", "deleted_by_actor_id", "policy_digest", "intent_digest",
        "idempotency_digest", "decision_digest", "revocation_digest", "audit_event_digest",
        "previous_provenance_digest", "provenance_digest", "created_at", "updated_at", "revision"
      ],
      "properties": {
        "schema_version": {"const": "coh.case-lifecycle/v1"},
        "contract_version": {"const": "1.0.0"},
        "case": {"$ref": "#/$defs/case"},
        "creator_actor_id": {"$ref": "#/$defs/uuid_v7"},
        "owner_actor_id": {"$ref": "#/$defs/uuid_v7"},
        "assignee_actor_id": {"$ref": "#/$defs/uuid_v7"},
        "classification": {"$ref": "#/$defs/classification"},
        "state": {"$ref": "#/$defs/state"},
        "retention_policy_id": {"$ref": "#/$defs/uuid_v7"},
        "retain_until": {"$ref": "#/$defs/timestamp"},
        "legal_hold": {"type": "boolean"},
        "hold_reason_digest": {"$ref": "#/$defs/optional_digest"},
        "last_export_manifest_digest": {"$ref": "#/$defs/optional_digest"},
        "export_count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "deletion_reason_digest": {"$ref": "#/$defs/optional_digest"},
        "deleted_by_actor_id": {"$ref": "#/$defs/optional_uuid_v7"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "intent_digest": {"$ref": "#/$defs/digest"},
        "idempotency_digest": {"$ref": "#/$defs/digest"},
        "decision_digest": {"$ref": "#/$defs/digest"},
        "revocation_digest": {"$ref": "#/$defs/digest"},
        "audit_event_digest": {"$ref": "#/$defs/digest"},
        "previous_provenance_digest": {"$ref": "#/$defs/optional_digest"},
        "provenance_digest": {"$ref": "#/$defs/digest"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": [
        "schema_version", "contract_version", "request_id", "operation", "case",
        "intent_digest", "idempotency_digest", "decision_digest", "revocation_digest",
        "audit_event_digest", "command", "record", "created_at", "receipt_digest"
      ],
      "properties": {
        "schema_version": {"const": "coh.case-receipt/v1"},
        "contract_version": {"const": "1.0.0"},
        "request_id": {"$ref": "#/$defs/uuid_v7"},
        "operation": {"$ref": "#/$defs/operation"},
        "case": {"$ref": "#/$defs/case"},
        "intent_digest": {"$ref": "#/$defs/digest"},
        "idempotency_digest": {"$ref": "#/$defs/digest"},
        "decision_digest": {"$ref": "#/$defs/digest"},
        "revocation_digest": {"$ref": "#/$defs/digest"},
        "audit_event_digest": {"$ref": "#/$defs/digest"},
        "command": {"$ref": "#/$defs/command"},
        "record": {"$ref": "#/$defs/record"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "receipt_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "operation": {"enum": ["create", "classify", "assign", "place_hold", "release_hold", "close", "reopen", "export", "delete"]},
    "state": {"enum": ["open", "closed", "deleted"]},
    "optional_state": {"oneOf": [{"$ref": "#/$defs/state"}, {"type": "null"}]},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "optional_classification": {"oneOf": [{"$ref": "#/$defs/classification"}, {"type": "null"}]},
    "uuid_v7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "optional_uuid_v7": {"oneOf": [{"$ref": "#/$defs/uuid_v7"}, {"type": "null"}]},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "optional_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "opaque": {"type": "string", "minLength": 1, "maxLength": 256},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"},
    "optional_timestamp": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
  }
}
