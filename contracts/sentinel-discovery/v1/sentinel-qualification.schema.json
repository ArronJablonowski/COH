{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coh.invalid/contracts/sentinel-discovery/v1/sentinel-qualification.schema.json","title":"COH Sentinel qualification","type":"object","additionalProperties":false,
  "required":["schema_version","contract_version","source_id","adapter_version","observed_at","valid_until","workspace_id","workspace_resource_id","region","api_version","config_digest","metadata_digest","receipts","digest"],
  "properties":{"schema_version":{"const":"coh.sentinel-qualification/v1"},"contract_version":{"const":"1.0.0"},"source_id":{"$ref":"#/$defs/token"},"adapter_version":{"$ref":"#/$defs/token"},"observed_at":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"workspace_id":{"$ref":"#/$defs/uuid"},"workspace_resource_id":{"type":"string","minLength":80,"maxLength":512},"region":{"$ref":"#/$defs/token"},"api_version":{"const":"v1"},"config_digest":{"$ref":"#/$defs/digest"},"metadata_digest":{"$ref":"#/$defs/digest"},"receipts":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/receipt"}},"digest":{"$ref":"#/$defs/digest"}},
