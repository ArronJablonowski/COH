{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coh.invalid/contracts/sentinel-discovery/v1/sentinel-metadata.schema.json","title":"COH Sentinel normalized metadata","type":"object","additionalProperties":false,
  "required":["schema_version","contract_version","workspace_id","workspace_resource_id","region","api_version","tables","digest"],
  "properties":{"schema_version":{"const":"coh.sentinel-metadata/v1"},"contract_version":{"const":"1.0.0"},"workspace_id":{"$ref":"#/$defs/uuid"},"workspace_resource_id":{"type":"string","minLength":80,"maxLength":512},"region":{"$ref":"#/$defs/token"},"api_version":{"const":"v1"},"tables":{"type":"array","minItems":1,"maxItems":10000,"items":{"$ref":"#/$defs/table"}},"digest":{"$ref":"#/$defs/digest"}},
  "$defs":{"token":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},"vendor":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_]{0,127}$"},"uuid":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"column":{"type":"object","additionalProperties":false,"required":["name","type"],"properties":{"name":{"$ref":"#/$defs/vendor"},"type":{"enum":["bool","datetime","decimal","dynamic","guid","int","long","real","string","timespan"]}}},"table":{"type":"object","additionalProperties":false,"required":["name","timespan_column","columns"],"properties":{"name":{"$ref":"#/$defs/vendor"},"timespan_column":{"$ref":"#/$defs/vendor"},"columns":{"type":"array","minItems":1,"maxItems":4096,"items":{"$ref":"#/$defs/column"}}}}}
}
