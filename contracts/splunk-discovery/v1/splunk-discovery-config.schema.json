{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/splunk-discovery/v1/splunk-discovery-config.schema.json",
  "title": "COH Splunk discovery configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "source_id", "adapter_version", "deployment", "endpoint", "expected_server_guid", "expected_product_type", "expected_server_roles", "qualified_minor_versions", "credential_reference", "tls_root_digest", "transport_identity_digest", "required_capabilities", "denied_capabilities", "resources", "fields", "hard_limits", "maximum_inventory_entries", "maximum_schema_entries_per_page", "qualification_lifetime_seconds"],
  "properties": {
    "schema_version": {"const": "coh.splunk-discovery-config/v1"},
    "contract_version": {"const": "1.0.0"},
    "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "adapter_version": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "deployment": {"const": "enterprise"},
    "endpoint": {"type": "string", "pattern": "^https://[^/?#]+/?$", "maxLength": 512},
    "expected_server_guid": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "expected_product_type": {"const": "enterprise"},
    "expected_server_roles": {"$ref": "#/$defs/names"},
    "qualified_minor_versions": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}},
    "credential_reference": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "tls_root_digest": {"$ref": "#/$defs/digest"},
    "transport_identity_digest": {"$ref": "#/$defs/digest"},
    "required_capabilities": {"type": "array", "prefixItems": [{"const": "search"}], "items": false, "minItems": 1, "maxItems": 1},
    "denied_capabilities": {"type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true, "items": {"type": "string"}},
    "resources": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["id", "index"], "properties": {"id": {"type": "string"}, "index": {"type": "string"}}}},
    "fields": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "object", "additionalProperties": false, "required": ["vendor_name", "schema_name", "type", "nullable", "indexed_required", "resource_ids"], "properties": {"vendor_name": {"type": "string"}, "schema_name": {"type": "string"}, "type": {"enum": ["string", "integer", "boolean", "timestamp", "ip", "bytes"]}, "nullable": {"type": "boolean"}, "indexed_required": {"type": "boolean"}, "resource_ids": {"$ref": "#/$defs/names"}}}},
    "hard_limits": {"type": "object", "additionalProperties": false, "required": ["maximum_rows", "maximum_bytes", "maximum_duration_millis", "maximum_pages", "maximum_slices", "maximum_cost_millionths", "requests_per_minute"], "properties": {"maximum_rows": {"type": "integer", "minimum": 1}, "maximum_bytes": {"type": "integer", "minimum": 1}, "maximum_duration_millis": {"type": "integer", "minimum": 1}, "maximum_pages": {"type": "integer", "minimum": 1}, "maximum_slices": {"type": "integer", "minimum": 1}, "maximum_cost_millionths": {"type": "integer", "minimum": 1}, "requests_per_minute": {"type": "integer", "minimum": 1}}},
    "maximum_inventory_entries": {"type": "integer", "minimum": 1, "maximum": 10000},
    "maximum_schema_entries_per_page": {"type": "integer", "minimum": 1, "maximum": 4096},
    "qualification_lifetime_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}}}
}
