{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://coh.invalid/contracts/splunk-discovery/v1/splunk-denials.schema.json", "title": "COH Splunk denial corpus",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "contract_version", "cases"],
  "properties": {"schema_version": {"const": "coh.splunk-denials/v1"}, "contract_version": {"const": "1.0.0"}, "cases": {"type": "array", "minItems": 12, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["class", "reason", "covered_by"], "properties": {"class": {"type": "string"}, "reason": {"type": "string", "minLength": 3, "maxLength": 160}, "covered_by": {"type": "string", "pattern": "^Test[A-Za-z0-9]{3,127}$"}}}}}
}
