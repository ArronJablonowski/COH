{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/evaluation/sentinel-slicing/v1/sentinel-slicing-evaluation.schema.json",
  "title": "COH Sentinel slicing evaluation v1",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bareDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{9}Z$"},
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_false_complete", "maximum_released_denied_rows", "minimum_outcome_grade_rate", "minimum_trajectory_grade_rate", "minimum_replay_rate", "minimum_boundary_coverage_rate"],
      "properties": {
        "maximum_false_complete": {"const": 0}, "maximum_released_denied_rows": {"const": 0},
        "minimum_outcome_grade_rate": {"const": 1}, "minimum_trajectory_grade_rate": {"const": 1},
        "minimum_replay_rate": {"const": 1}, "minimum_boundary_coverage_rate": {"const": 1}
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "completeness", "reason_codes", "rows_returned", "slices_completed", "released_rows"],
      "properties": {
        "outcome": {"enum": ["completed", "denied", "canceled", "unknown"]}, "completeness": {"enum": ["complete", "not_applicable"]},
        "reason_codes": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "rows_returned": {"type": "integer", "minimum": 0, "maximum": 100000}, "slices_completed": {"type": "integer", "minimum": 0, "maximum": 1000},
        "released_rows": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "boundary", "fault", "recording_id", "recording_sha256", "expected", "trajectory"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "boundary": {"enum": ["timespan", "slicing", "dedupe", "ambiguity", "partial_error", "cancellation", "recovery", "binding", "limits"]},
        "fault": {"enum": ["none", "missing_timespan", "boundary_duplicate", "duplicate_conflict", "timestamp_ambiguity", "partial_error", "cancel", "timeout", "uncertain_retry", "tamper", "slice_limit"]},
        "recording_id": {"$ref": "#/$defs/id"}, "recording_sha256": {"$ref": "#/$defs/digest"},
        "expected": {"$ref": "#/$defs/expected"},
        "trajectory": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"$ref": "#/$defs/token"}}
      }
    },
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "corpus_version", "issue", "requirements", "trials_per_task", "thresholds", "tasks"],
      "properties": {
        "schema_version": {"const": "coh.sentinel-slicing-corpus/v1"}, "corpus_version": {"const": "1.0.0"}, "issue": {"const": "COH-E14-06"},
        "requirements": {"const": ["EVAL-016", "FR-052", "FR-054"]}, "trials_per_task": {"const": 5}, "thresholds": {"$ref": "#/$defs/thresholds"},
        "tasks": {"type": "array", "minItems": 10, "maxItems": 64, "items": {"$ref": "#/$defs/task"}}
      }
    },
    "pin": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "sha256"],
      "properties": {"name": {"$ref": "#/$defs/token"}, "version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "environment_version", "corpus_version", "go_version", "qualified_platform", "clock", "randomness", "network", "contracts", "fixtures"],
      "properties": {
        "schema_version": {"const": "coh.sentinel-slicing-environment/v1"}, "environment_version": {"const": "1.0.0"}, "corpus_version": {"const": "1.0.0"},
        "go_version": {"const": "1.26.7"}, "qualified_platform": {"const": "darwin/arm64"}, "clock": {"const": "logical-trial-clock/v1"},
        "randomness": {"const": "none"}, "network": {"const": "disabled"},
        "contracts": {"type": "array", "minItems": 5, "maxItems": 16, "items": {"$ref": "#/$defs/pin"}},
        "fixtures": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/pin"}}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "event", "slice_start", "slice_end", "end_exclusive", "row_keys", "row_digests", "outcome", "partial", "threshold_reached", "request_digest", "response_digest"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 64}, "event": {"$ref": "#/$defs/token"}, "slice_start": {"$ref": "#/$defs/timestamp"}, "slice_end": {"$ref": "#/$defs/timestamp"},
        "end_exclusive": {"type": "boolean"}, "row_keys": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/token"}},
        "row_digests": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/digest"}}, "outcome": {"enum": ["ok", "error", "canceled", "timeout", "unavailable"]},
        "partial": {"type": "boolean"}, "threshold_reached": {"type": "boolean"}, "request_digest": {"$ref": "#/$defs/digest"}, "response_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "recording": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "boundary", "fault", "sanitized", "network", "steps", "expected", "trajectory"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "boundary": {"enum": ["timespan", "slicing", "dedupe", "ambiguity", "partial_error", "cancellation", "recovery", "binding", "limits"]},
        "fault": {"enum": ["none", "missing_timespan", "boundary_duplicate", "duplicate_conflict", "timestamp_ambiguity", "partial_error", "cancel", "timeout", "uncertain_retry", "tamper", "slice_limit"]},
        "sanitized": {"const": true}, "network": {"const": "disabled"}, "steps": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/step"}},
        "expected": {"$ref": "#/$defs/expected"}, "trajectory": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"$ref": "#/$defs/token"}}
      }
    },
    "recordingSet": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "recording_version", "sanitized", "network", "recordings"],
      "properties": {"schema_version": {"const": "coh.sentinel-slicing-recordings/v1"}, "recording_version": {"const": "1.0.0"}, "sanitized": {"const": true}, "network": {"const": "disabled"}, "recordings": {"type": "array", "minItems": 10, "maxItems": 64, "items": {"$ref": "#/$defs/recording"}}}
    },
    "observed": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "completeness", "reason_codes", "rows_returned", "slices_completed", "released_rows"],
      "properties": {"outcome": {"type": "string"}, "completeness": {"type": "string"}, "reason_codes": {"type": "array", "items": {"type": "string"}}, "rows_returned": {"type": "integer"}, "slices_completed": {"type": "integer"}, "released_rows": {"type": "integer"}}
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "corpus_digest", "environment_digest", "task_digest", "task_id", "trial", "events", "observed", "replay_digest"],
      "properties": {"schema_version": {"const": "coh.sentinel-slicing-trace/v1"}, "corpus_digest": {"$ref": "#/$defs/digest"}, "environment_digest": {"$ref": "#/$defs/digest"}, "task_digest": {"$ref": "#/$defs/digest"}, "task_id": {"$ref": "#/$defs/id"}, "trial": {"type": "integer", "minimum": 1, "maximum": 5}, "events": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"$ref": "#/$defs/token"}}, "observed": {"$ref": "#/$defs/observed"}, "replay_digest": {"$ref": "#/$defs/digest"}}
    },
    "metrics": {
      "type": "object", "additionalProperties": false, "required": ["task_count", "trial_count", "false_complete", "released_denied_rows", "outcome_grade_rate", "trajectory_grade_rate", "replay_rate", "boundary_coverage_rate"],
      "properties": {"task_count": {"type": "integer", "minimum": 10}, "trial_count": {"type": "integer", "minimum": 50}, "false_complete": {"type": "integer", "minimum": 0}, "released_denied_rows": {"type": "integer", "minimum": 0}, "outcome_grade_rate": {"type": "number", "minimum": 0, "maximum": 1}, "trajectory_grade_rate": {"type": "number", "minimum": 0, "maximum": 1}, "replay_rate": {"type": "number", "minimum": 0, "maximum": 1}, "boundary_coverage_rate": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "graders": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "corpus_digest", "environment_digest", "trace_stream_digest", "metrics"],
      "properties": {"schema_version": {"const": "coh.sentinel-slicing-graders/v1"}, "corpus_digest": {"$ref": "#/$defs/digest"}, "environment_digest": {"$ref": "#/$defs/digest"}, "trace_stream_digest": {"$ref": "#/$defs/digest"}, "metrics": {"$ref": "#/$defs/metrics"}}
    },
    "threshold": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "corpus_digest", "environment_digest", "thresholds", "metrics", "passed"],
      "properties": {"schema_version": {"const": "coh.sentinel-slicing-threshold/v1"}, "corpus_digest": {"$ref": "#/$defs/digest"}, "environment_digest": {"$ref": "#/$defs/digest"}, "thresholds": {"$ref": "#/$defs/thresholds"}, "metrics": {"$ref": "#/$defs/metrics"}, "passed": {"type": "boolean"}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "length"],
      "properties": {"path": {"$ref": "#/$defs/token"}, "sha256": {"$ref": "#/$defs/bareDigest"}, "length": {"type": "integer", "minimum": 1, "maximum": 104857600}}
    },
    "artifacts": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "corpus_digest", "environment_digest", "reproduction_command", "artifacts"],
      "properties": {"schema_version": {"const": "coh.sentinel-slicing-artifacts/v1"}, "corpus_digest": {"$ref": "#/$defs/digest"}, "environment_digest": {"$ref": "#/$defs/digest"}, "reproduction_command": {"const": "./scripts/verify_sentinel_slicing.sh"}, "artifacts": {"type": "array", "minItems": 6, "maxItems": 16, "items": {"$ref": "#/$defs/artifact"}}}
    }
  },
  "oneOf": [{"$ref": "#/$defs/corpus"}, {"$ref": "#/$defs/environment"}, {"$ref": "#/$defs/recordingSet"}, {"$ref": "#/$defs/trace"}, {"$ref": "#/$defs/graders"}, {"$ref": "#/$defs/threshold"}, {"$ref": "#/$defs/artifacts"}]
}
