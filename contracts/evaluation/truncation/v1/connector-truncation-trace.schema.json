{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.example/contracts/evaluation/truncation/v1/connector-truncation-trace.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "corpus_version", "corpus_digest", "environment_digest", "task_digest", "task_id", "trial", "events", "observed", "outcome_grade", "trajectory_grade", "replay_digest"],
  "properties": {
    "schema_version": {"const": "coh.connector-truncation-trace/v1"},
    "corpus_version": {"const": "1.0.0"},
    "corpus_digest": {"$ref": "#/$defs/digest"}, "environment_digest": {"$ref": "#/$defs/digest"},
    "task_digest": {"$ref": "#/$defs/digest"}, "replay_digest": {"$ref": "#/$defs/digest"},
    "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "trial": {"type": "integer", "minimum": 1, "maximum": 100},
    "events": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/token"}},
    "observed": {"$ref": "#/$defs/observed"}, "outcome_grade": {"type": "boolean"},
    "trajectory_grade": {"type": "boolean"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
    "observed": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "completeness_status", "reason_codes", "truncated", "partial", "vendor_confirmed", "rows_returned", "pages_returned", "duplicate_rows", "missing_rows", "adaptive_slicing"],
      "properties": {
        "outcome": {"enum": ["completed", "partial", "denied", "canceled", "unknown"]},
        "completeness_status": {"enum": ["complete", "partial", "unknown", "not_applicable"]},
        "reason_codes": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}},
        "truncated": {"type": "boolean"}, "partial": {"type": "boolean"}, "vendor_confirmed": {"type": "boolean"},
        "rows_returned": {"type": "integer", "minimum": 0}, "pages_returned": {"type": "integer", "minimum": 0},
        "duplicate_rows": {"type": "integer", "minimum": 0}, "missing_rows": {"type": "integer", "minimum": 0},
        "adaptive_slicing": {"enum": ["not_requested", "proven", "unsupported"]}
      }
    }
  }
}
