{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.example/contracts/evaluation/truncation/v1/connector-truncation-corpus.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_version", "requirements", "trials_per_task", "thresholds", "tasks"],
  "properties": {
    "schema_version": {"const": "coh.connector-truncation-corpus/v1"},
    "corpus_version": {"const": "1.0.0"},
    "requirements": {"const": ["FR-054", "EVAL-016"]},
    "trials_per_task": {"const": 5},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "tasks": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_false_complete", "maximum_duplicate_rows", "maximum_missing_rows", "minimum_replay_rate", "minimum_outcome_grade_rate", "minimum_trajectory_grade_rate", "minimum_boundary_coverage_rate"],
      "properties": {
        "maximum_false_complete": {"const": 0}, "maximum_duplicate_rows": {"const": 0},
        "maximum_missing_rows": {"const": 0}, "minimum_replay_rate": {"const": 1},
        "minimum_outcome_grade_rate": {"const": 1}, "minimum_trajectory_grade_rate": {"const": 1},
        "minimum_boundary_coverage_rate": {"const": 1}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]{1,512}$"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "completeness_status", "reason_codes", "truncated", "partial", "vendor_confirmed", "rows_returned", "pages_returned", "adaptive_slicing"],
      "properties": {
        "outcome": {"enum": ["completed", "partial", "denied", "canceled", "unknown"]},
        "completeness_status": {"enum": ["complete", "partial", "unknown", "not_applicable"]},
        "reason_codes": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}},
        "truncated": {"type": "boolean"}, "partial": {"type": "boolean"},
        "vendor_confirmed": {"type": "boolean"}, "rows_returned": {"type": "integer", "minimum": 0, "maximum": 100000},
        "pages_returned": {"type": "integer", "minimum": 0, "maximum": 10000},
        "adaptive_slicing": {"enum": ["not_requested", "proven", "unsupported"]}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "vendor", "mode", "boundary", "fault", "fixtures", "expected", "trajectory"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "vendor": {"enum": ["elastic", "security_onion"]},
        "mode": {"enum": ["esql", "query_dsl_pit", "oql_events", "oql_metrics", "adaptive_slice"]},
        "boundary": {"type": "string", "pattern": "^(schema|response|sort|pit|limit|cancellation|recovery|slicing)\\.[a-z_]+$"},
        "fault": {"enum": ["none", "schema_drift", "partial_response", "repeated_sort", "pit_expiry", "pit_rotation", "documented_cap", "undocumented_cap", "embedded_error", "timeout", "cancel", "lost_state", "unproven_slice"]},
        "fixtures": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/fixture"}},
        "expected": {"$ref": "#/$defs/expected"},
        "trajectory": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/token"}}
      }
    }
  }
}
