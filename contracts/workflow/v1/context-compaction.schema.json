{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/workflow/v1/context-compaction.schema.json",
  "title": "COH evidence-safe context compaction records v1",
  "oneOf": [
    { "$ref": "#/$defs/intent" },
    { "$ref": "#/$defs/state" }
  ],
  "$defs": {
    "intent": {
      "type": "object",
      "required": ["schema_version", "contract_version", "compaction_id", "run_id", "task_id", "case", "policy_digest", "provider_route", "sources", "created_at", "deadline"],
      "properties": {
        "schema_version": { "const": "coh.context-compaction/v1" },
        "contract_version": { "const": "1.0.0" },
        "compaction_id": { "$ref": "#/$defs/uuid_v7" },
        "run_id": { "$ref": "#/$defs/uuid_v7" },
        "task_id": { "$ref": "#/$defs/uuid_v7" },
        "case": { "$ref": "#/$defs/case" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "provider_route": { "$ref": "#/$defs/token" },
        "sources": { "$ref": "#/$defs/sources" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "deadline": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["schema_version", "contract_version", "compaction_id", "run_id", "task_id", "case", "policy_digest", "provider_route", "sources", "source_manifest_digest", "intent_digest", "idempotency_digest", "summary", "summary_trust", "status", "reason_code", "previous_provenance_digest", "provenance_digest", "created_at", "deadline", "updated_at", "revision"],
      "properties": {
        "schema_version": { "const": "coh.context-compaction/v1" },
        "contract_version": { "const": "1.0.0" },
        "compaction_id": { "$ref": "#/$defs/uuid_v7" },
        "run_id": { "$ref": "#/$defs/uuid_v7" },
        "task_id": { "$ref": "#/$defs/uuid_v7" },
        "case": { "$ref": "#/$defs/case" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "provider_route": { "$ref": "#/$defs/token" },
        "sources": { "$ref": "#/$defs/sources" },
        "source_manifest_digest": { "$ref": "#/$defs/digest" },
        "intent_digest": { "$ref": "#/$defs/digest" },
        "idempotency_digest": { "$ref": "#/$defs/digest" },
        "summary": { "$ref": "#/$defs/artifact_slot" },
        "summary_trust": { "const": "untrusted_evidence" },
        "status": { "enum": ["writing", "completed", "uncertain"] },
        "reason_code": { "enum": ["summary_writing", "summary_completed", "summary_outcome_uncertain", "summary_reference_invalid", "summary_canceled", "summary_timeout", "summary_dependency_unavailable"] },
        "previous_provenance_digest": { "$ref": "#/$defs/optional_digest" },
        "provenance_digest": { "$ref": "#/$defs/digest" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "deadline": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "summary": { "$ref": "#/$defs/artifact_ref" },
              "reason_code": { "const": "summary_completed" },
              "previous_provenance_digest": { "$ref": "#/$defs/digest" },
              "revision": { "const": 2 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "writing" } }, "required": ["status"] },
          "then": {
            "properties": {
              "summary": { "$ref": "#/$defs/empty_artifact" },
              "reason_code": { "const": "summary_writing" },
              "previous_provenance_digest": { "const": "" },
              "revision": { "const": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "uncertain" } }, "required": ["status"] },
          "then": {
            "properties": {
              "summary": { "$ref": "#/$defs/empty_artifact" },
              "reason_code": { "enum": ["summary_outcome_uncertain", "summary_reference_invalid", "summary_canceled", "summary_timeout", "summary_dependency_unavailable"] },
              "previous_provenance_digest": { "$ref": "#/$defs/digest" },
              "revision": { "const": 2 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["sequence", "evidence_id", "evidence_digest", "trust", "source_time", "normalized_time", "original_timezone", "precision", "clock_uncertainty_nanoseconds", "order_confidence", "result_state", "completeness", "uncertainty"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 512 },
        "evidence_id": { "$ref": "#/$defs/uuid_v7" },
        "evidence_digest": { "$ref": "#/$defs/digest" },
        "trust": { "const": "untrusted_evidence" },
        "source_time": { "type": "string", "minLength": 1, "maxLength": 64 },
        "normalized_time": { "$ref": "#/$defs/timestamp" },
        "original_timezone": { "type": "string", "pattern": "^[A-Za-z0-9_+:/.-]{1,64}$" },
        "precision": { "enum": ["nanosecond", "microsecond", "millisecond", "second", "minute", "hour", "day", "unknown"] },
        "clock_uncertainty_nanoseconds": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "order_confidence": { "enum": ["strict", "overlap", "unknown"] },
        "result_state": { "enum": ["observed", "negative", "gap", "conflicting", "error"] },
        "completeness": { "enum": ["complete", "partial", "truncated", "unavailable", "unknown"] },
        "uncertainty": { "enum": ["none", "bounded", "clock", "conflicting", "unknown"] }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/source" }
    },
    "case": {
      "type": "object",
      "required": ["organization_id", "tenant_id", "case_id"],
      "properties": {
        "organization_id": { "$ref": "#/$defs/uuid_v7" },
        "tenant_id": { "$ref": "#/$defs/uuid_v7" },
        "case_id": { "$ref": "#/$defs/uuid_v7" }
      },
      "additionalProperties": false
    },
    "artifact_slot": {
      "type": "object",
      "required": ["digest", "media_type", "classification", "length"],
      "properties": {
        "digest": { "$ref": "#/$defs/optional_digest" },
        "media_type": { "enum": ["", "application/json"] },
        "classification": { "oneOf": [{ "$ref": "#/$defs/token" }, { "type": "string", "maxLength": 0 }] },
        "length": { "type": "integer", "minimum": 0, "maximum": 1073741824 }
      },
      "additionalProperties": false
    },
    "artifact_ref": {
      "type": "object",
      "required": ["digest", "media_type", "classification", "length"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "media_type": { "const": "application/json" },
        "classification": { "$ref": "#/$defs/token" },
        "length": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
      },
      "additionalProperties": false
    },
    "empty_artifact": {
      "type": "object",
      "required": ["digest", "media_type", "classification", "length"],
      "properties": {
        "digest": { "const": "" },
        "media_type": { "const": "" },
        "classification": { "const": "" },
        "length": { "const": 0 }
      },
      "additionalProperties": false
    },
    "uuid_v7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "optional_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "string", "maxLength": 0 }] },
    "token": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{9}Z$" }
  }
}
