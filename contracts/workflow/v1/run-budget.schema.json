{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/workflow/v1/run-budget.schema.json",
  "title": "COH run and task budget records v1",
  "oneOf": [
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/ledger" }
  ],
  "$defs": {
    "plan": {
      "type": "object",
      "required": ["schema_version", "contract_version", "run_id", "case", "policy_digest", "provider_route", "limits", "created_at", "expires_at"],
      "properties": {
        "schema_version": { "const": "coh.run-budget/v1" },
        "contract_version": { "const": "1.0.0" },
        "run_id": { "$ref": "#/$defs/uuid_v7" },
        "case": { "$ref": "#/$defs/case" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "provider_route": { "$ref": "#/$defs/token" },
        "limits": { "$ref": "#/$defs/limit_vector" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "required": ["schema_version", "contract_version", "run_id", "case", "plan_digest", "policy_digest", "provider_route", "limits", "charged", "active_concurrency", "reservations", "reason_code", "previous_provenance_digest", "provenance_digest", "created_at", "expires_at", "updated_at", "revision"],
      "properties": {
        "schema_version": { "const": "coh.run-budget/v1" },
        "contract_version": { "const": "1.0.0" },
        "run_id": { "$ref": "#/$defs/uuid_v7" },
        "case": { "$ref": "#/$defs/case" },
        "plan_digest": { "$ref": "#/$defs/digest" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "provider_route": { "$ref": "#/$defs/token" },
        "limits": { "$ref": "#/$defs/limit_vector" },
        "charged": { "$ref": "#/$defs/charged_vector" },
        "active_concurrency": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "reservations": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/reservation" } },
        "reason_code": { "$ref": "#/$defs/token" },
        "previous_provenance_digest": { "$ref": "#/$defs/optional_digest" },
        "provenance_digest": { "$ref": "#/$defs/digest" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
      },
      "additionalProperties": false
    },
    "reservation": {
      "type": "object",
      "required": ["reservation_digest", "claim_digest", "settlement_digest", "settlement_idempotency_digest", "idempotency_digest", "task_id", "parent_task_id", "activity", "policy_digest", "provider_route", "deadline", "task_limits", "claim", "actual", "outcome", "status", "created_at", "settled_at"],
      "properties": {
        "reservation_digest": { "$ref": "#/$defs/digest" },
        "claim_digest": { "$ref": "#/$defs/digest" },
        "settlement_digest": { "$ref": "#/$defs/optional_digest" },
        "settlement_idempotency_digest": { "$ref": "#/$defs/optional_digest" },
        "idempotency_digest": { "$ref": "#/$defs/digest" },
        "task_id": { "$ref": "#/$defs/uuid_v7" },
        "parent_task_id": { "oneOf": [{ "$ref": "#/$defs/uuid_v7" }, { "type": "string", "maxLength": 0 }] },
        "activity": { "$ref": "#/$defs/token" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "provider_route": { "$ref": "#/$defs/token" },
        "deadline": { "$ref": "#/$defs/timestamp" },
        "task_limits": { "$ref": "#/$defs/limit_vector" },
        "claim": { "$ref": "#/$defs/claim_vector" },
        "actual": { "$ref": "#/$defs/actual_vector" },
        "outcome": { "enum": ["", "succeeded", "denied", "canceled", "timeout", "failed", "uncertain"] },
        "status": { "enum": ["active", "settled"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "settled_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "string", "maxLength": 0 }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "active" } } },
          "then": {
            "properties": {
              "settlement_digest": { "type": "string", "maxLength": 0 },
              "settlement_idempotency_digest": { "type": "string", "maxLength": 0 },
              "outcome": { "const": "" },
              "settled_at": { "type": "string", "maxLength": 0 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "settled" } } },
          "then": {
            "properties": {
              "settlement_digest": { "$ref": "#/$defs/digest" },
              "settlement_idempotency_digest": { "$ref": "#/$defs/digest" },
              "outcome": { "enum": ["succeeded", "denied", "canceled", "timeout", "failed", "uncertain"] },
              "settled_at": { "$ref": "#/$defs/timestamp" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["organization_id", "tenant_id", "case_id"],
      "properties": {
        "organization_id": { "$ref": "#/$defs/uuid_v7" },
        "tenant_id": { "$ref": "#/$defs/uuid_v7" },
        "case_id": { "$ref": "#/$defs/uuid_v7" }
      },
      "additionalProperties": false
    },
    "limit_vector": {
      "type": "object",
      "required": ["tokens", "cost_micros", "wall_time_nanoseconds", "tool_calls", "query_rows", "evidence_bytes", "delegation_depth", "fanout", "concurrency"],
      "properties": {
        "tokens": { "$ref": "#/$defs/positive_u64" },
        "cost_micros": { "$ref": "#/$defs/positive_u64" },
        "wall_time_nanoseconds": { "$ref": "#/$defs/positive_u64" },
        "tool_calls": { "$ref": "#/$defs/positive_u64" },
        "query_rows": { "$ref": "#/$defs/positive_u64" },
        "evidence_bytes": { "$ref": "#/$defs/positive_u64" },
        "delegation_depth": { "$ref": "#/$defs/positive_u32" },
        "fanout": { "$ref": "#/$defs/positive_u32" },
        "concurrency": { "$ref": "#/$defs/positive_u32" }
      },
      "additionalProperties": false
    },
    "claim_vector": {
      "type": "object",
      "required": ["tokens", "cost_micros", "wall_time_nanoseconds", "tool_calls", "query_rows", "evidence_bytes", "delegation_depth", "fanout", "concurrency"],
      "properties": {
        "tokens": { "$ref": "#/$defs/u64" },
        "cost_micros": { "$ref": "#/$defs/u64" },
        "wall_time_nanoseconds": { "$ref": "#/$defs/positive_u64" },
        "tool_calls": { "$ref": "#/$defs/u64" },
        "query_rows": { "$ref": "#/$defs/u64" },
        "evidence_bytes": { "$ref": "#/$defs/u64" },
        "delegation_depth": { "$ref": "#/$defs/u32" },
        "fanout": { "$ref": "#/$defs/u32" },
        "concurrency": { "$ref": "#/$defs/positive_u32" }
      },
      "additionalProperties": false
    },
    "actual_vector": {
      "type": "object",
      "required": ["tokens", "cost_micros", "wall_time_nanoseconds", "tool_calls", "query_rows", "evidence_bytes", "delegation_depth", "fanout", "concurrency"],
      "properties": {
        "tokens": { "$ref": "#/$defs/u64" },
        "cost_micros": { "$ref": "#/$defs/u64" },
        "wall_time_nanoseconds": { "$ref": "#/$defs/u64" },
        "tool_calls": { "$ref": "#/$defs/u64" },
        "query_rows": { "$ref": "#/$defs/u64" },
        "evidence_bytes": { "$ref": "#/$defs/u64" },
        "delegation_depth": { "$ref": "#/$defs/u32" },
        "fanout": { "$ref": "#/$defs/u32" },
        "concurrency": { "$ref": "#/$defs/u32" }
      },
      "additionalProperties": false
    },
    "charged_vector": {
      "type": "object",
      "required": ["tokens", "cost_micros", "wall_time_nanoseconds", "tool_calls", "query_rows", "evidence_bytes", "delegation_depth", "fanout", "concurrency"],
      "properties": {
        "tokens": { "$ref": "#/$defs/u64" },
        "cost_micros": { "$ref": "#/$defs/u64" },
        "wall_time_nanoseconds": { "const": 0 },
        "tool_calls": { "$ref": "#/$defs/u64" },
        "query_rows": { "$ref": "#/$defs/u64" },
        "evidence_bytes": { "$ref": "#/$defs/u64" },
        "delegation_depth": { "const": 0 },
        "fanout": { "const": 0 },
        "concurrency": { "const": 0 }
      },
      "additionalProperties": false
    },
    "uuid_v7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "optional_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "string", "maxLength": 0 }] },
    "token": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{9}Z$" },
    "u64": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "positive_u64": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "positive_u32": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
  }
}
