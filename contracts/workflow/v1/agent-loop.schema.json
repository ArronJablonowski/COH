{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/workflow/v1/agent-loop.schema.json",
  "title": "COH durable agent loop records v1",
  "$defs": {
    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{9}Z$"
    },
    "references": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "run_data": {
      "type": "object",
      "required": [
        "contract_version", "initiating_actor_id", "workflow_type", "workflow_version",
        "policy_digest", "provider_route", "budget_plan_digest", "status", "current_step_id", "sequence",
        "input_refs", "output_refs", "provenance_digest", "updated_at"
      ],
      "properties": {
        "contract_version": {"const": "coh.agent-loop/v1"},
        "initiating_actor_id": {"$ref": "#/$defs/uuid_v7"},
        "workflow_type": {"const": "coh.agent-loop.v1"},
        "workflow_version": {"const": "1.0.0"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "provider_route": {"$ref": "#/$defs/token"},
        "budget_plan_digest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["running", "waiting", "succeeded", "failed", "denied", "canceled", "timeout", "uncertain"]},
        "current_step_id": {"$ref": "#/$defs/uuid_v7"},
        "sequence": {"type": "integer", "minimum": 1},
        "input_refs": {"$ref": "#/$defs/references"},
        "output_refs": {"$ref": "#/$defs/references"},
        "provenance_digest": {"$ref": "#/$defs/digest"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "step_data": {
      "type": "object",
      "required": [
        "contract_version", "run_id", "activity_kind", "status", "attempt", "deadline",
        "input_refs", "output_refs", "intent_digest", "receipt_digest", "budget_reservation_digest",
        "budget_settlement_digest", "provenance_digest", "updated_at"
      ],
      "properties": {
        "contract_version": {"const": "coh.agent-loop/v1"},
        "run_id": {"$ref": "#/$defs/uuid_v7"},
        "activity_kind": {"enum": ["planning", "authorized_action"]},
        "status": {"enum": ["pending", "running", "dispatching", "succeeded", "failed", "denied", "canceled", "timeout", "uncertain"]},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 1000},
        "deadline": {"$ref": "#/$defs/timestamp"},
        "input_refs": {"$ref": "#/$defs/references"},
        "output_refs": {"$ref": "#/$defs/references"},
        "intent_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"const": ""}]},
        "receipt_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"const": ""}]},
        "budget_reservation_digest": {"$ref": "#/$defs/digest"},
        "budget_settlement_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"const": ""}]},
        "provenance_digest": {"$ref": "#/$defs/digest"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"activity_kind": {"const": "planning"}}, "required": ["activity_kind"]},
          "then": {"properties": {"intent_digest": {"const": ""}}}
        },
        {
          "if": {"properties": {"activity_kind": {"const": "authorized_action"}}, "required": ["activity_kind"]},
          "then": {"properties": {"intent_digest": {"$ref": "#/$defs/digest"}}}
        }
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["schema", "kind", "id", "organization_id", "tenant_id", "case_id", "revision", "created_at", "data"],
      "properties": {
        "schema": {"const": "coh.domain/v1"},
        "kind": {"const": "run"},
        "id": {"$ref": "#/$defs/uuid_v7"},
        "organization_id": {"$ref": "#/$defs/uuid_v7"},
        "tenant_id": {"$ref": "#/$defs/uuid_v7"},
        "case_id": {"$ref": "#/$defs/uuid_v7"},
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "data": {"$ref": "#/$defs/run_data"}
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["schema", "kind", "id", "organization_id", "tenant_id", "case_id", "revision", "created_at", "data"],
      "properties": {
        "schema": {"const": "coh.domain/v1"},
        "kind": {"const": "task"},
        "id": {"$ref": "#/$defs/uuid_v7"},
        "organization_id": {"$ref": "#/$defs/uuid_v7"},
        "tenant_id": {"$ref": "#/$defs/uuid_v7"},
        "case_id": {"$ref": "#/$defs/uuid_v7"},
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "data": {"$ref": "#/$defs/step_data"}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [{"$ref": "#/$defs/run"}, {"$ref": "#/$defs/step"}]
}
