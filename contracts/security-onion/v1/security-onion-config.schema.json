{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.example/contracts/security-onion/v1/security-onion-config.schema.json",
  "title": "COH Security Onion Connect configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "source_id", "adapter_version", "endpoint", "credential_reference", "tls_root_digest", "transport_identity_digest", "permissions", "resources", "fields", "projection", "stable_sort", "timestamp_field", "hard_limits", "maximum_interval_seconds", "maximum_event_limit", "maximum_metric_limit", "maximum_openapi_bytes", "qualification_lifetime_seconds"],
  "properties": {
    "schema_version": {"const": "coh.security-onion-config/v1"},
    "contract_version": {"const": "1.0.0"},
    "source_id": {"$ref": "#/$defs/name"},
    "adapter_version": {"$ref": "#/$defs/name"},
    "endpoint": {"type": "string", "pattern": "^https://[^/?#]+/?$", "maxLength": 512},
    "credential_reference": {"$ref": "#/$defs/name"},
    "tls_root_digest": {"$ref": "#/$defs/digest"},
    "transport_identity_digest": {"$ref": "#/$defs/digest"},
    "permissions": {"const": ["events/read"]},
    "resources": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "fields": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/field"}},
    "projection": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "stable_sort": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "timestamp_field": {"$ref": "#/$defs/name"},
    "tenant_field": {"$ref": "#/$defs/optionalName"},
    "source_field": {"$ref": "#/$defs/optionalName"},
    "hard_limits": {"$ref": "#/$defs/limits"},
    "maximum_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 2678400},
    "maximum_event_limit": {"type": "integer", "minimum": 1, "maximum": 100000},
    "maximum_metric_limit": {"type": "integer", "minimum": 1, "maximum": 100000},
    "maximum_openapi_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "qualification_lifetime_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "optionalName": {"type": "string", "pattern": "^$|^[a-z][a-z0-9_.-]{0,127}$"},
    "vendorName": {"type": "string", "pattern": "^@?[A-Za-z_][A-Za-z0-9_.-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "vendor_name", "type", "exact", "range", "exists", "projectable", "groupable", "sortable"],
      "properties": {
        "name": {"$ref": "#/$defs/name"}, "vendor_name": {"$ref": "#/$defs/vendorName"},
        "type": {"enum": ["string", "integer", "boolean", "timestamp", "ip"]},
        "exact": {"type": "boolean"}, "range": {"type": "boolean"}, "exists": {"type": "boolean"},
        "projectable": {"type": "boolean"}, "groupable": {"type": "boolean"}, "sortable": {"type": "boolean"}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_rows", "maximum_bytes", "maximum_duration_millis", "maximum_pages", "maximum_slices", "maximum_cost_millionths", "requests_per_minute"],
      "properties": {
        "maximum_rows": {"type": "integer", "minimum": 1}, "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maximum_duration_millis": {"type": "integer", "minimum": 1, "maximum": 120000},
        "maximum_pages": {"type": "integer", "minimum": 1}, "maximum_slices": {"type": "integer", "minimum": 1},
        "maximum_cost_millionths": {"type": "integer", "minimum": 1}, "requests_per_minute": {"type": "integer", "minimum": 1}
      }
    }
  }
}
