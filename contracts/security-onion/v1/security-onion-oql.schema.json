{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.example/contracts/security-onion/v1/security-onion-oql.schema.json",
  "title": "COH structured Security Onion OQL document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "filter"],
  "properties": {
    "mode": {"enum": ["events", "metrics"]},
    "filter": {"$ref": "#/$defs/node"},
    "group_by": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "scalar": {"type": ["string", "integer", "boolean"]},
    "node": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["match_all"], "properties": {"match_all": {"type": "object", "maxProperties": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["term"], "properties": {"term": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"$ref": "#/$defs/scalar"}}}},
        {"type": "object", "additionalProperties": false, "required": ["terms"], "properties": {"terms": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/scalar"}}}}},
        {"type": "object", "additionalProperties": false, "required": ["exists"], "properties": {"exists": {"type": "object", "additionalProperties": false, "required": ["field"], "properties": {"field": {"$ref": "#/$defs/name"}}}}},
        {"type": "object", "additionalProperties": false, "required": ["range"], "properties": {"range": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"gt": {"$ref": "#/$defs/scalar"}, "gte": {"$ref": "#/$defs/scalar"}, "lt": {"$ref": "#/$defs/scalar"}, "lte": {"$ref": "#/$defs/scalar"}}}}}},
        {"type": "object", "additionalProperties": false, "required": ["bool"], "properties": {"bool": {"type": "object", "additionalProperties": false, "properties": {"filter": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/node"}}, "should": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/node"}}, "must_not": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/node"}}, "minimum_should_match": {"const": 1}}}}}
      ]
    }
  }
}
