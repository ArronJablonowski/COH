{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/credential/v1/issuance-request.schema.json",
  "title": "COH broker credential-lease issuance request v1",
  "type": "object",
  "required": ["schema_version", "contract_version", "request_id", "idempotency_key", "context", "task_id", "action_digest", "target_digests", "operation", "audience", "credential_class", "reference", "requested_ttl_seconds"],
  "properties": {
    "schema_version": {"const": "coh.credential-lease/v1"},
    "contract_version": {"const": "1.0.0"},
    "request_id": {"$ref": "#/$defs/uuid_v7"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "context": {
      "type": "object",
      "required": ["organization_id", "tenant_id", "case_id", "actor_id"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/uuid_v7"},
        "tenant_id": {"$ref": "#/$defs/uuid_v7"},
        "case_id": {"$ref": "#/$defs/uuid_v7"},
        "actor_id": {"$ref": "#/$defs/uuid_v7"}
      },
      "additionalProperties": false
    },
    "task_id": {"$ref": "#/$defs/uuid_v7"},
    "action_digest": {"$ref": "#/$defs/digest"},
    "target_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "operation": {"$ref": "#/$defs/token"},
    "audience": {
      "type": "object",
      "required": ["kind", "id", "transport_identity_digest"],
      "properties": {
        "kind": {"enum": ["connector", "runner"]},
        "id": {"$ref": "#/$defs/token"},
        "transport_identity_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "credential_class": {"$ref": "#/$defs/token"},
    "reference": {"$ref": "../../secret/v1/secret-reference.schema.json"},
    "requested_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
  },
  "$defs": {
    "uuid_v7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}
  },
  "additionalProperties": false
}
