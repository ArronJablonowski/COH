{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coh.invalid/contracts/pysigma-helper/v1/redacted-trace.schema.json","title":"COH pySigma redacted trace","type":"object","additionalProperties":false,
  "required":["schema_version","contract_version","trace_id","events","native_text_exposed","sigma_text_exposed","field_name_exposed","credential_exposed","path_exposed"],
  "properties":{"schema_version":{"const":"coh.pysigma-redacted-trace/v1"},"contract_version":{"const":"1.0.0"},"trace_id":{"$ref":"#/$defs/uuid"},"events":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/event"}},"native_text_exposed":{"const":false},"sigma_text_exposed":{"const":false},"field_name_exposed":{"const":false},"credential_exposed":{"const":false},"path_exposed":{"const":false}},
  "$defs":{"uuid":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"reason":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"token":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},"event":{"type":"object","additionalProperties":false,"required":["sequence","phase","outcome","reason_codes","request_digest"],"properties":{"sequence":{"type":"integer","minimum":1,"maximum":64},"phase":{"$ref":"#/$defs/token"},"outcome":{"enum":["accepted","denied","unavailable"]},"reason_codes":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/reason"}},"request_digest":{"$ref":"#/$defs/digest"}}}}
}
