{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.local/contracts/approval/v1/approval-fingerprint.schema.json",
  "title": "COH approval fingerprint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "fingerprint_digest", "manifest_digest", "policy_decision_digest", "organization_id", "tenant_id", "case_id", "requestor_actor_id", "action_owner_actor_id", "policy_digest", "policy_revision", "roe_digest", "valid_from", "valid_until", "maximum_use_count"],
  "properties": {
    "schema_version": {"const": "coh.approval-fingerprint/v1"},
    "contract_version": {"const": "1.0.0"},
    "fingerprint_digest": {"$ref": "#/$defs/digest"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "policy_decision_digest": {"$ref": "#/$defs/digest"},
    "organization_id": {"$ref": "#/$defs/uuidv7"},
    "tenant_id": {"$ref": "#/$defs/uuidv7"},
    "case_id": {"$ref": "#/$defs/uuidv7"},
    "requestor_actor_id": {"$ref": "#/$defs/uuidv7"},
    "action_owner_actor_id": {"$ref": "#/$defs/uuidv7"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "policy_revision": {"type": "integer", "minimum": 1},
    "roe_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "valid_from": {"$ref": "#/$defs/timestamp"},
    "valid_until": {"$ref": "#/$defs/timestamp"},
    "maximum_use_count": {"type": "integer", "minimum": 1, "maximum": 1000}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"}
  }
}
