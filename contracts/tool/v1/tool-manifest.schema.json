{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/tool/v1/tool-manifest.schema.json",
  "title": "COH reviewed tool manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "manifest_id", "tool_name", "tool_version",
    "artifact_digest", "maximum_action_tier", "publisher_id", "review_id", "review_revision",
    "review_decision", "reviewer_actor_ids", "threat_model_digest", "reviewed_at",
    "valid_from", "valid_until", "operations"
  ],
  "properties": {
    "schema_version": {"const": "coh.tool-manifest/v1"},
    "contract_version": {"const": "1.0.0"},
    "manifest_id": {"$ref": "#/$defs/uuid_v7"},
    "tool_name": {"$ref": "#/$defs/token"},
    "tool_version": {"$ref": "#/$defs/version"},
    "artifact_digest": {"$ref": "#/$defs/digest"},
    "maximum_action_tier": {"$ref": "#/$defs/tier"},
    "publisher_id": {"$ref": "#/$defs/uuid_v7"},
    "review_id": {"$ref": "#/$defs/uuid_v7"},
    "review_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "review_decision": {"const": "approved"},
    "reviewer_actor_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid_v7"}},
    "threat_model_digest": {"$ref": "#/$defs/digest"},
    "reviewed_at": {"$ref": "#/$defs/timestamp"},
    "valid_from": {"$ref": "#/$defs/timestamp"},
    "valid_until": {"$ref": "#/$defs/timestamp"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "uuid_v7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[1-9][0-9]{0,8}([.][0-9]{1,9}){0,2}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{9}Z$"},
    "tier": {"enum": ["T0", "T1", "T2", "T3", "T4"]},
    "nullable_integer": {"oneOf": [{"type": "integer"}, {"type": "null"}]},
    "input_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "minimum", "maximum", "maximum_bytes", "maximum_items", "enum"],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "type": {"enum": ["boolean", "integer", "duration_ms", "string", "uuid", "digest", "timestamp", "string_list", "digest_list"]},
        "required": {"type": "boolean"},
        "minimum": {"$ref": "#/$defs/nullable_integer"},
        "maximum": {"$ref": "#/$defs/nullable_integer"},
        "maximum_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "maximum_items": {"type": "integer", "minimum": 0, "maximum": 256},
        "enum": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_milliseconds", "cpu_milliseconds", "memory_bytes", "output_bytes", "ephemeral_storage_bytes", "process_count", "open_file_count"],
      "properties": {
        "wall_time_milliseconds": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "cpu_milliseconds": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "memory_bytes": {"type": "integer", "minimum": 16777216, "maximum": 68719476736},
        "output_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "ephemeral_storage_bytes": {"type": "integer", "minimum": 1, "maximum": 274877906944},
        "process_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "open_file_count": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "protocols", "dns_mode", "public_internet_allowed", "metadata_allowed", "maximum_connections"],
      "properties": {
        "mode": {"enum": ["none", "target_only", "target_and_control"]},
        "protocols": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["tcp", "udp"]}},
        "dns_mode": {"enum": ["none", "broker_resolved"]},
        "public_internet_allowed": {"const": false},
        "metadata_allowed": {"const": false},
        "maximum_connections": {"type": "integer", "minimum": 0, "maximum": 65535}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input_schema_version", "input_fields", "baseline_action_tier", "maximum_action_tier", "isolation_class", "credential_classes", "resource_limits", "network_policy", "cancellation_mode", "retry_mode"],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "input_schema_version": {"const": "coh.tool-input/v1"},
        "input_fields": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/input_field"}},
        "baseline_action_tier": {"$ref": "#/$defs/tier"},
        "maximum_action_tier": {"$ref": "#/$defs/tier"},
        "isolation_class": {"enum": ["native_restricted", "oci_sandbox", "remote_isolated", "t4_dedicated"]},
        "credential_classes": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "resource_limits": {"$ref": "#/$defs/resource_limits"},
        "network_policy": {"$ref": "#/$defs/network_policy"},
        "cancellation_mode": {"enum": ["cooperative", "broker_only", "unsupported"]},
        "retry_mode": {"enum": ["safe", "reconcile", "never"]}
      }
    }
  }
}
