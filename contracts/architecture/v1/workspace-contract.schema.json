{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/architecture/v1/workspace-contract.schema.json",
  "title": "COH Go workspace boundary contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "canonicalization",
    "go_baseline",
    "module",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "coh.architecture/v1"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^1\\.0\\.(0|[1-9][0-9]*)$"
    },
    "canonicalization": {
      "const": "COH-JSON-C14N-1"
    },
    "go_baseline": {
      "const": "1.26.7"
    },
    "module": {
      "const": "github.com/ArronJablonowski/COH"
    },
    "boundaries": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/boundary"
      }
    }
  },
  "$defs": {
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "roots", "purpose", "may_import"],
      "properties": {
        "name": {
          "enum": [
            "command",
            "broker",
            "domain",
            "policy",
            "workflow",
            "provider",
            "connector",
            "persistence",
            "transport",
            "ui",
            "helper"
          ]
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(cmd|internal)/[A-Za-z0-9_./-]*[A-Za-z0-9_-]$|^cmd$"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "may_import": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "command",
              "broker",
              "domain",
              "policy",
              "workflow",
              "provider",
              "connector",
              "persistence",
              "transport",
              "ui",
              "helper"
            ]
          }
        }
      }
    }
  }
}
