{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/action/v1/action-manifest.schema.json",
  "title": "COH canonical action manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "manifest_id", "workflow_task_id",
    "organization_id", "tenant_id", "case_id", "requestor_actor_id",
    "action_owner_actor_id", "action_type", "operation", "action_tier",
    "target_digests", "exclusion_digests", "arguments_digest", "tool",
    "payload_digest", "policy_digest", "policy_revision", "roe_digest",
    "credential_class", "credential_reference_digest", "execution_zone",
    "isolation_profile_digest", "valid_from", "valid_until", "manifest_nonce",
    "maximum_use_count", "rollback_digest", "safety_watch_actor_id"
  ],
  "properties": {
    "schema_version": {"const": "coh.action-manifest/v1"},
    "contract_version": {"const": "1.0.0"},
    "manifest_id": {"$ref": "#/$defs/uuid_v7"},
    "workflow_task_id": {"$ref": "#/$defs/uuid_v7"},
    "organization_id": {"$ref": "#/$defs/uuid_v7"},
    "tenant_id": {"$ref": "#/$defs/uuid_v7"},
    "case_id": {"$ref": "#/$defs/uuid_v7"},
    "requestor_actor_id": {"$ref": "#/$defs/uuid_v7"},
    "action_owner_actor_id": {"$ref": "#/$defs/uuid_v7"},
    "action_type": {"$ref": "#/$defs/token"},
    "operation": {"$ref": "#/$defs/token"},
    "action_tier": {"enum": ["T0", "T1", "T2", "T3", "T4"]},
    "target_digests": {"$ref": "#/$defs/nonempty_digest_set"},
    "exclusion_digests": {"$ref": "#/$defs/digest_set"},
    "arguments_digest": {"$ref": "#/$defs/digest"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "version": {"$ref": "#/$defs/version"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "payload_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "policy_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "roe_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "credential_class": {"$ref": "#/$defs/token"},
    "credential_reference_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "execution_zone": {"$ref": "#/$defs/token"},
    "isolation_profile_digest": {"$ref": "#/$defs/digest"},
    "valid_from": {"$ref": "#/$defs/timestamp"},
    "valid_until": {"$ref": "#/$defs/timestamp"},
    "manifest_nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "maximum_use_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "rollback_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "safety_watch_actor_id": {"oneOf": [{"$ref": "#/$defs/uuid_v7"}, {"type": "null"}]}
  },
  "$defs": {
    "uuid_v7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[1-9][0-9]{0,8}([.][0-9]{1,9}){0,2}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{9}Z$"},
    "digest_set": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "nonempty_digest_set": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}
  }
}
