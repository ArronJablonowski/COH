{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/action/v1/signed-action-envelope.schema.json",
  "title": "COH signed action envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "manifest", "manifest_digest",
    "signer_actor_id", "signer_key_revision", "key_id",
    "signature_algorithm", "signature"
  ],
  "properties": {
    "schema_version": {"const": "coh.signed-action/v1"},
    "contract_version": {"const": "1.0.0"},
    "manifest": {"$ref": "action-manifest.schema.json"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "signer_actor_id": {"$ref": "#/$defs/uuid_v7"},
    "signer_key_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "key_id": {"$ref": "#/$defs/token"},
    "signature_algorithm": {"const": "ed25519"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "$defs": {
    "uuid_v7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}
  }
}
