{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/secret/v1/secret-reference.schema.json",
  "title": "COH opaque secret reference v1",
  "type": "object",
  "required": ["schema_version", "contract_version", "backend", "entry_id", "version"],
  "properties": {
    "schema_version": {"const": "coh.secret-reference/v1"},
    "contract_version": {"const": "1.0.0"},
    "backend": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "entry_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "version": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
