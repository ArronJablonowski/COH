{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/secret/v1/resolution-request.schema.json",
  "title": "COH broker secret-resolution request v1",
  "type": "object",
  "required": ["schema_version", "contract_version", "request_id", "idempotency_key", "context", "action_digest", "credential_class", "reference"],
  "properties": {
    "schema_version": {"const": "coh.secret-reference/v1"},
    "contract_version": {"const": "1.0.0"},
    "request_id": {"$ref": "#/$defs/uuid_v7"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "context": {
      "type": "object",
      "required": ["organization_id", "tenant_id", "case_id", "actor_id"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/uuid_v7"},
        "tenant_id": {"$ref": "#/$defs/uuid_v7"},
        "case_id": {"$ref": "#/$defs/uuid_v7"},
        "actor_id": {"$ref": "#/$defs/uuid_v7"}
      },
      "additionalProperties": false
    },
    "action_digest": {"$ref": "#/$defs/digest"},
    "credential_class": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "reference": {"$ref": "secret-reference.schema.json"}
  },
  "$defs": {
    "uuid_v7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
