{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/query-runtime/v1/query-runtime.schema.json",
  "title": "COH governed query runtime v1",
  "$defs": {
    "uuid_v7": {"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "token": {"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},
    "timestamp": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{9}Z$"},
    "limits": {
      "type":"object","additionalProperties":false,
      "required":["maximum_rows","maximum_bytes","maximum_duration_millis","maximum_pages","maximum_slices","maximum_cost_millionths","requests_per_minute"],
      "properties":{
        "maximum_rows":{"type":"integer","minimum":1},"maximum_bytes":{"type":"integer","minimum":1},
        "maximum_duration_millis":{"type":"integer","minimum":1},"maximum_pages":{"type":"integer","minimum":1},
        "maximum_slices":{"type":"integer","minimum":1},"maximum_cost_millionths":{"type":"integer","minimum":1},
        "requests_per_minute":{"type":"integer","minimum":1}
      }
    },
    "usage": {
      "type":"object","additionalProperties":false,
      "required":["rows_scanned","rows_returned","bytes_returned","duration_millis","pages_returned","slices_completed","cost_millionths"],
      "properties":{
        "rows_scanned":{"type":"integer","minimum":0},"rows_returned":{"type":"integer","minimum":0},
        "bytes_returned":{"type":"integer","minimum":0},"duration_millis":{"type":"integer","minimum":0},
        "pages_returned":{"type":"integer","minimum":0},"slices_completed":{"type":"integer","minimum":0},
        "cost_millionths":{"type":"integer","minimum":0}
      }
    },
    "session": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","contract_version","session_digest","session_id","revision","query_id","query_digest","bounds_decision_digest","execution_digest","attempt_id","organization_id","tenant_id","case_id","actor_id","source_id","mode","effective_limits","usage","status","reason_code","next_page_number","poll_delay_millis","next_poll_at","job_handle_digest","vendor_provenance_digest","started_at","updated_at","deadline"],
      "properties":{
        "schema_version":{"const":"coh.query-runtime-session/v1"},"contract_version":{"const":"1.0.0"},
        "session_digest":{"$ref":"#/$defs/digest"},"previous_session_digest":{"$ref":"#/$defs/digest"},
        "session_id":{"$ref":"#/$defs/uuid_v7"},"revision":{"type":"integer","minimum":1},
        "query_id":{"$ref":"#/$defs/uuid_v7"},"query_digest":{"$ref":"#/$defs/digest"},
        "bounds_decision_digest":{"$ref":"#/$defs/digest"},"execution_digest":{"$ref":"#/$defs/digest"},
        "attempt_id":{"$ref":"#/$defs/uuid_v7"},"organization_id":{"$ref":"#/$defs/uuid_v7"},
        "tenant_id":{"$ref":"#/$defs/uuid_v7"},"case_id":{"$ref":"#/$defs/uuid_v7"},"actor_id":{"$ref":"#/$defs/uuid_v7"},
        "source_id":{"$ref":"#/$defs/token"},"mode":{"enum":["interactive","export"]},
        "effective_limits":{"$ref":"#/$defs/limits"},"usage":{"$ref":"#/$defs/usage"},
        "status":{"enum":["running","complete","partial","truncated","canceled","uncertain","failed"]},
        "reason_code":{"$ref":"#/$defs/token"},"next_page_number":{"type":"integer","minimum":1},
        "poll_delay_millis":{"type":"integer","minimum":1,"maximum":60000},"next_poll_at":{"$ref":"#/$defs/timestamp"},
        "job_handle_digest":{"$ref":"#/$defs/digest"},"page_handle_digest":{"$ref":"#/$defs/digest"},
        "last_page_digest":{"$ref":"#/$defs/digest"},"last_rate_reservation_digest":{"$ref":"#/$defs/digest"},
        "cancellation_intent_digest":{"$ref":"#/$defs/digest"},"vendor_provenance_digest":{"$ref":"#/$defs/digest"},
        "started_at":{"$ref":"#/$defs/timestamp"},"updated_at":{"$ref":"#/$defs/timestamp"},"deadline":{"$ref":"#/$defs/timestamp"}
      }
    },
    "slice_descriptor": {
      "type":"object","additionalProperties":false,"required":["slice_digest","index","count","start","end"],
      "properties":{"slice_digest":{"$ref":"#/$defs/digest"},"index":{"type":"integer","minimum":1,"maximum":4096},
        "count":{"type":"integer","minimum":1,"maximum":4096},"start":{"$ref":"#/$defs/timestamp"},"end":{"$ref":"#/$defs/timestamp"}}
    },
    "slice_plan": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","contract_version","plan_digest","parent_query_id","parent_query_digest","bounds_decision_digest","slices"],
      "properties":{"schema_version":{"const":"coh.query-slice-plan/v1"},"contract_version":{"const":"1.0.0"},
        "plan_digest":{"$ref":"#/$defs/digest"},"parent_query_id":{"$ref":"#/$defs/uuid_v7"},
        "parent_query_digest":{"$ref":"#/$defs/digest"},"bounds_decision_digest":{"$ref":"#/$defs/digest"},
        "slices":{"type":"array","minItems":1,"maxItems":4096,"items":{"$ref":"#/$defs/slice_descriptor"}}}
    },
    "rate_reservation": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","contract_version","reservation_digest","key_digest","session_id","operation","sequence","reserved_at","valid_until"],
      "properties":{"schema_version":{"const":"coh.query-rate-reservation/v1"},"contract_version":{"const":"1.0.0"},
        "reservation_digest":{"$ref":"#/$defs/digest"},"key_digest":{"$ref":"#/$defs/digest"},
        "session_id":{"$ref":"#/$defs/uuid_v7"},"operation":{"enum":["poll","next_page","cancel","protective_cancel"]},
        "sequence":{"type":"integer","minimum":1},"reserved_at":{"$ref":"#/$defs/timestamp"},"valid_until":{"$ref":"#/$defs/timestamp"}}
    }
  },
  "oneOf":[{"$ref":"#/$defs/session"},{"$ref":"#/$defs/slice_plan"},{"$ref":"#/$defs/rate_reservation"}]
}
