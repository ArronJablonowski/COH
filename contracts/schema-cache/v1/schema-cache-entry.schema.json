{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/schema-cache/v1/schema-cache-entry.schema.json",
  "title": "COH bounded schema-cache entry identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "organization_id",
    "tenant_id",
    "source_id",
    "resource_digest",
    "capability_digest",
    "adapter_version",
    "connector_schema_version",
    "page_digest",
    "vendor_schema_digest",
    "provenance_digest",
    "cached_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "coh.schema-cache-entry/v1"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "organization_id": {
      "$ref": "#/$defs/uuid_v7"
    },
    "tenant_id": {
      "$ref": "#/$defs/uuid_v7"
    },
    "source_id": {
      "$ref": "#/$defs/token"
    },
    "resource_digest": {
      "$ref": "#/$defs/digest"
    },
    "capability_digest": {
      "$ref": "#/$defs/digest"
    },
    "adapter_version": {
      "$ref": "#/$defs/token"
    },
    "connector_schema_version": {
      "const": "coh.query-schema/v1"
    },
    "page_digest": {
      "$ref": "#/$defs/digest"
    },
    "vendor_schema_digest": {
      "$ref": "#/$defs/digest"
    },
    "provenance_digest": {
      "$ref": "#/$defs/digest"
    },
    "cached_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{9}Z$"
    }
  }
}
