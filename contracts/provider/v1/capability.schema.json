{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/provider/v1/capability.schema.json",
  "title": "COH provider capability snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "snapshot_id", "observed_at",
    "valid_until", "provider", "features", "limits"
  ],
  "properties": {
    "schema_version": {"const": "coh.provider-capability/v1"},
    "contract_version": {"const": "1.0.0"},
    "snapshot_id": {"$ref": "#/$defs/uuid7"},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "provider": {"$ref": "#/$defs/provider_identity"},
    "features": {"$ref": "#/$defs/features"},
    "limits": {"$ref": "#/$defs/limits"}
  },
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bounded_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+:-]*$"
    },
    "provider_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_kind", "adapter_version", "endpoint_identity_digest",
        "data_route", "requested_model", "actual_model", "model_revision",
        "runtime_name", "runtime_version", "runtime_digest",
        "tokenizer_name", "tokenizer_version", "tokenizer_digest",
        "chat_template_digest", "tool_parser_digest", "reasoning_parser_digest",
        "context_limit", "sampling_profile_digest", "hardware_profile_digest",
        "state_mode", "policy_revision"
      ],
      "properties": {
        "provider_kind": {"enum": ["ollama", "llama_cpp", "vllm", "openai_responses", "codex_runtime"]},
        "adapter_version": {"type": "string", "pattern": "^[0-9]+([.][0-9]+){1,3}([+-][A-Za-z0-9.-]+)?$"},
        "endpoint_identity_digest": {"$ref": "#/$defs/digest"},
        "data_route": {"enum": ["local", "approved_external", "air_gapped"]},
        "requested_model": {"type": "string", "minLength": 1, "maxLength": 256},
        "actual_model": {"type": "string", "minLength": 1, "maxLength": 256},
        "model_revision": {"$ref": "#/$defs/digest"},
        "runtime_name": {"$ref": "#/$defs/bounded_name"},
        "runtime_version": {"type": "string", "pattern": "^[0-9]+([.][0-9]+){1,3}([+-][A-Za-z0-9.-]+)?$"},
        "runtime_digest": {"$ref": "#/$defs/digest"},
        "tokenizer_name": {"$ref": "#/$defs/bounded_name"},
        "tokenizer_version": {"type": "string", "pattern": "^[0-9]+([.][0-9]+){1,3}([+-][A-Za-z0-9.-]+)?$"},
        "tokenizer_digest": {"$ref": "#/$defs/digest"},
        "chat_template_digest": {"$ref": "#/$defs/digest"},
        "tool_parser_digest": {"$ref": "#/$defs/digest"},
        "reasoning_parser_digest": {"$ref": "#/$defs/digest"},
        "context_limit": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "sampling_profile_digest": {"$ref": "#/$defs/digest"},
        "hardware_profile_digest": {"$ref": "#/$defs/digest"},
        "state_mode": {"enum": ["stateless", "client_managed", "provider_managed"]},
        "policy_revision": {"type": "integer", "minimum": 1}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_roles", "content_kinds", "tool_calls", "structured_output",
        "streaming", "cancellation", "usage", "state_modes"
      ],
      "properties": {
        "message_roles": {
          "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
          "items": {"enum": ["system", "developer", "user", "assistant", "tool"]}
        },
        "content_kinds": {
          "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
          "items": {"enum": ["text", "input_json", "output_json", "tool_call", "tool_result", "reasoning_ref"]}
        },
        "tool_calls": {"type": "boolean"},
        "structured_output": {"type": "boolean"},
        "streaming": {"type": "boolean"},
        "cancellation": {"type": "boolean"},
        "usage": {"type": "boolean"},
        "state_modes": {
          "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
          "items": {"enum": ["stateless", "client_managed", "provider_managed"]}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_input_tokens", "maximum_output_tokens", "maximum_messages",
        "maximum_tools", "maximum_parallel_tool_calls", "maximum_stream_seconds"
      ],
      "properties": {
        "maximum_input_tokens": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "maximum_output_tokens": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maximum_messages": {"type": "integer", "minimum": 1, "maximum": 16384},
        "maximum_tools": {"type": "integer", "minimum": 0, "maximum": 1024},
        "maximum_parallel_tool_calls": {"type": "integer", "minimum": 0, "maximum": 256},
        "maximum_stream_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    }
  }
}
