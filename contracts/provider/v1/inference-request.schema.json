{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/provider/v1/inference-request.schema.json",
  "title": "COH provider inference request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "request_id", "attempt_id",
    "organization_id", "tenant_id", "case_id", "task_id", "actor_id",
    "provider", "capability_digest", "qualification_id", "messages", "tools",
    "output_constraint", "sampling", "maximum_output_tokens", "state",
    "deadline", "authorization_digest", "policy_decision_digest",
    "approval_decision_digest", "audit_reservation_digest"
  ],
  "properties": {
    "schema_version": {"const": "coh.provider-request/v1"},
    "contract_version": {"const": "1.0.0"},
    "request_id": {"$ref": "capability.schema.json#/$defs/uuid7"},
    "attempt_id": {"$ref": "capability.schema.json#/$defs/uuid7"},
    "organization_id": {"$ref": "capability.schema.json#/$defs/uuid7"},
    "tenant_id": {"$ref": "capability.schema.json#/$defs/uuid7"},
    "case_id": {"$ref": "capability.schema.json#/$defs/uuid7"},
    "task_id": {"$ref": "capability.schema.json#/$defs/uuid7"},
    "actor_id": {"$ref": "capability.schema.json#/$defs/uuid7"},
    "provider": {"$ref": "capability.schema.json#/$defs/provider_identity"},
    "capability_digest": {"$ref": "capability.schema.json#/$defs/digest"},
    "qualification_id": {"$ref": "capability.schema.json#/$defs/uuid7"},
    "messages": {
      "type": "array", "minItems": 1, "maxItems": 16384,
      "items": {"$ref": "#/$defs/message"}
    },
    "tools": {
      "type": "array", "maxItems": 1024,
      "items": {"$ref": "#/$defs/tool"}
    },
    "output_constraint": {"$ref": "#/$defs/output_constraint"},
    "sampling": {"$ref": "#/$defs/sampling"},
    "maximum_output_tokens": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "state": {"$ref": "#/$defs/state"},
    "deadline": {"type": "string", "format": "date-time"},
    "authorization_digest": {"$ref": "capability.schema.json#/$defs/digest"},
    "policy_decision_digest": {"$ref": "capability.schema.json#/$defs/digest"},
    "approval_decision_digest": {"$ref": "capability.schema.json#/$defs/digest"},
    "audit_reservation_digest": {"$ref": "capability.schema.json#/$defs/digest"}
  },
  "$defs": {
    "message": {
      "type": "object", "additionalProperties": false,
      "required": ["message_id", "role", "items"],
      "properties": {
        "message_id": {"$ref": "capability.schema.json#/$defs/uuid7"},
        "role": {"enum": ["system", "developer", "user", "assistant", "tool"]},
        "items": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/content_item"}}
      }
    },
    "content_item": {
      "oneOf": [
        {"$ref": "#/$defs/text_item"},
        {"$ref": "#/$defs/json_item"},
        {"$ref": "#/$defs/tool_call"},
        {"$ref": "#/$defs/tool_result"},
        {"$ref": "#/$defs/reasoning_ref"}
      ]
    },
    "text_item": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {"kind": {"const": "text"}, "text": {"type": "string", "maxLength": 8388608}}
    },
    "json_item": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "value", "schema_digest"],
      "properties": {
        "kind": {"enum": ["input_json", "output_json"]},
        "value": {"type": "object"},
        "schema_digest": {"$ref": "capability.schema.json#/$defs/digest"}
      }
    },
    "tool_call": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "call_id", "tool_name", "arguments", "input_schema_digest"],
      "properties": {
        "kind": {"const": "tool_call"},
        "call_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "tool_name": {"$ref": "capability.schema.json#/$defs/bounded_name"},
        "arguments": {"type": "object"},
        "input_schema_digest": {"$ref": "capability.schema.json#/$defs/digest"}
      }
    },
    "tool_result": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "call_id", "outcome", "value", "output_schema_digest", "result_digest"],
      "properties": {
        "kind": {"const": "tool_result"},
        "call_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "outcome": {"enum": ["succeeded", "denied", "canceled", "timeout", "failed", "uncertain"]},
        "value": {"type": "object"},
        "output_schema_digest": {"$ref": "capability.schema.json#/$defs/digest"},
        "result_digest": {"$ref": "capability.schema.json#/$defs/digest"}
      }
    },
    "reasoning_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reference_id", "digest"],
      "properties": {
        "kind": {"const": "reasoning_ref"},
        "reference_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "digest": {"$ref": "capability.schema.json#/$defs/digest"}
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "description", "input_schema_digest", "output_schema_digest"],
      "properties": {
        "name": {"$ref": "capability.schema.json#/$defs/bounded_name"},
        "description": {"type": "string", "minLength": 1, "maxLength": 4096},
        "input_schema_digest": {"$ref": "capability.schema.json#/$defs/digest"},
        "output_schema_digest": {"$ref": "capability.schema.json#/$defs/digest"}
      }
    },
    "output_constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["text", "json_schema"]},
        "name": {"$ref": "capability.schema.json#/$defs/bounded_name"},
        "schema_digest": {"$ref": "capability.schema.json#/$defs/digest"},
        "strict": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "text"}}}, "then": {"not": {"anyOf": [{"required": ["name"]}, {"required": ["schema_digest"]}, {"required": ["strict"]}]}}},
        {"if": {"properties": {"kind": {"const": "json_schema"}}}, "then": {"required": ["name", "schema_digest", "strict"], "properties": {"strict": {"const": true}}}}
      ]
    },
    "sampling": {
      "type": "object", "additionalProperties": false,
      "required": ["temperature_milli", "top_p_millionths", "seed"],
      "properties": {
        "temperature_milli": {"type": "integer", "minimum": 0, "maximum": 2000},
        "top_p_millionths": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["stateless", "client_managed", "provider_managed"]},
        "reference_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "state_digest": {"$ref": "capability.schema.json#/$defs/digest"}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "stateless"}}}, "then": {"not": {"anyOf": [{"required": ["reference_id"]}, {"required": ["state_digest"]}]}}},
        {"if": {"properties": {"mode": {"enum": ["client_managed", "provider_managed"]}}}, "then": {"required": ["reference_id", "state_digest"]}}
      ]
    }
  }
}
