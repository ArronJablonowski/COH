{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coh.invalid/contracts/kusto-validator/v1/revocation.schema.json","title":"COH Kusto validator revocation","type":"object","additionalProperties":false,"required":["schema_version","contract_version","decision_digest","helper_attestation_digest","revocation_digest","audit_reservation_digest","reason_code","observed_at","validation_permitted","execution_permitted"],"properties":{"schema_version":{"const":"coh.kusto-validator-revocation/v1"},"contract_version":{"const":"1.0.0"},"decision_digest":{"$ref":"#/$defs/digest"},"helper_attestation_digest":{"$ref":"#/$defs/digest"},"revocation_digest":{"$ref":"#/$defs/digest"},"audit_reservation_digest":{"$ref":"#/$defs/digest"},"reason_code":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"observed_at":{"type":"string","format":"date-time"},"validation_permitted":{"const":false},"execution_permitted":{"const":false}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}
