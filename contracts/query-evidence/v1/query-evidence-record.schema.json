{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.local/contracts/query-evidence/v1/query-evidence-record.schema.json",
  "title": "COH Query Evidence Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "record_digest", "provenance_digest", "transition_id", "revision", "stream", "case", "actor_id", "source_id", "query_digest", "bounds_decision_digest", "execution_digest", "validator_version", "validator_provenance_digest", "interval_start", "interval_end", "resource_scope_digest", "native_query", "event", "runtime_session_revision", "runtime_session_digest", "completeness", "reason_code", "statistics", "occurred_at"],
  "properties": {
    "schema_version": {"const": "coh.query-evidence-record/v1"},
    "contract_version": {"const": "1.0.0"},
    "record_digest": {"$ref": "#/$defs/digest"},
    "provenance_digest": {"$ref": "#/$defs/digest"},
    "previous_provenance_digest": {"$ref": "#/$defs/digest"},
    "transition_id": {"$ref": "#/$defs/digest"},
    "revision": {"type": "integer", "minimum": 1},
    "stream": {"$ref": "#/$defs/stream"},
    "case": {"$ref": "#/$defs/case"},
    "actor_id": {"$ref": "#/$defs/uuid"},
    "source_id": {"$ref": "#/$defs/token"},
    "query_digest": {"$ref": "#/$defs/digest"},
    "bounds_decision_digest": {"$ref": "#/$defs/digest"},
    "execution_digest": {"$ref": "#/$defs/digest"},
    "validator_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "validator_provenance_digest": {"$ref": "#/$defs/digest"},
    "interval_start": {"$ref": "#/$defs/timestamp"},
    "interval_end": {"$ref": "#/$defs/timestamp"},
    "resource_scope_digest": {"$ref": "#/$defs/digest"},
    "native_query": {"$ref": "#/$defs/artifact_binding"},
    "event": {"enum": ["started", "validated", "page", "result", "truncated", "partial", "cancellation_requested", "canceled", "uncertain", "failed"]},
    "runtime_session_revision": {"type": "integer", "minimum": 1},
    "runtime_session_digest": {"$ref": "#/$defs/digest"},
    "result": {"$ref": "#/$defs/artifact_binding"},
    "result_digest": {"$ref": "#/$defs/digest"},
    "completeness": {"enum": ["running", "complete", "partial", "truncated", "canceled", "uncertain", "failed"]},
    "reason_code": {"$ref": "#/$defs/token"},
    "statistics": {"$ref": "#/$defs/statistics"},
    "cancellation_intent_digest": {"$ref": "#/$defs/digest"},
    "cancellation_outcome_digest": {"$ref": "#/$defs/digest"},
    "occurred_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"},
    "stream": {"type": "object", "additionalProperties": false, "required": ["organization_id", "tenant_id", "case_id", "query_id", "attempt_id"], "properties": {"organization_id": {"$ref": "#/$defs/uuid"}, "tenant_id": {"$ref": "#/$defs/uuid"}, "case_id": {"$ref": "#/$defs/uuid"}, "query_id": {"$ref": "#/$defs/uuid"}, "attempt_id": {"$ref": "#/$defs/uuid"}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["organization_id", "tenant_id", "case_id"], "properties": {"organization_id": {"$ref": "#/$defs/uuid"}, "tenant_id": {"$ref": "#/$defs/uuid"}, "case_id": {"$ref": "#/$defs/uuid"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["digest", "media_type", "classification", "length"], "properties": {"digest": {"$ref": "#/$defs/digest"}, "media_type": {"type": "string", "minLength": 1, "maxLength": 255}, "classification": {"$ref": "#/$defs/token"}, "length": {"type": "integer", "minimum": 1}}},
    "artifact_binding": {"type": "object", "additionalProperties": false, "required": ["artifact", "manifest", "manifest_provenance_digest", "ingestion_receipt_digest"], "properties": {"artifact": {"$ref": "#/$defs/artifact"}, "manifest": {"$ref": "#/$defs/artifact"}, "manifest_provenance_digest": {"$ref": "#/$defs/digest"}, "ingestion_receipt_digest": {"$ref": "#/$defs/digest"}}},
    "statistics": {"type": "object", "additionalProperties": false, "required": ["rows_scanned", "rows_returned", "bytes_returned", "duration_millis", "pages_returned", "slices_completed", "cost_millionths"], "properties": {"rows_scanned": {"type": "integer", "minimum": 0}, "rows_returned": {"type": "integer", "minimum": 0}, "bytes_returned": {"type": "integer", "minimum": 0}, "duration_millis": {"type": "integer", "minimum": 0}, "pages_returned": {"type": "integer", "minimum": 0}, "slices_completed": {"type": "integer", "minimum": 0}, "cost_millionths": {"type": "integer", "minimum": 0}}}
  }
}
