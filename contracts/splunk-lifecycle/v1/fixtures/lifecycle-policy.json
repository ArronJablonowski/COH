{
  "schema_version": "coh.splunk-lifecycle-policy/v1",
  "contract_version": "1.0.0",
  "execution_mode": "normal",
  "allow_previews": false,
  "status_buckets": 0,
  "maximum_page_rows": 1000,
  "minimum_poll_interval_millis": 500,
  "cancellation_wait_millis": 5000,
  "operations": [
    "splunk.search.cancel",
    "splunk.search.create",
    "splunk.search.results",
    "splunk.search.status"
  ],
  "allowed_states": [
    "BAD_INPUT_CANCEL",
    "DONE",
    "FAILED",
    "FINALIZING",
    "INTERNAL_CANCEL",
    "PARSING",
    "PAUSE",
    "QUEUED",
    "QUIT",
    "RUNNING",
    "USER_CANCEL"
  ]
}
