{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coh.invalid/contracts/splunk-lifecycle/v1/splunk-lifecycle-policy.schema.json","title":"COH Splunk lifecycle policy","type":"object","additionalProperties":false,
