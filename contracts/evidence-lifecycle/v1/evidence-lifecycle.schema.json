{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.local/contracts/evidence-lifecycle/v1/evidence-lifecycle.schema.json",
  "title": "COH signed evidence lifecycle v1",
  "oneOf": [
    {"$ref": "#/$defs/command"},
    {"$ref": "#/$defs/export_manifest"},
    {"$ref": "#/$defs/detached_signature"},
    {"$ref": "#/$defs/package_header"},
    {"$ref": "#/$defs/import_verification"},
    {"$ref": "#/$defs/authorization_request"},
    {"$ref": "#/$defs/decision"},
    {"$ref": "#/$defs/progress"},
    {"$ref": "#/$defs/disposition_attestation"},
    {"$ref": "#/$defs/record"},
    {"$ref": "#/$defs/receipt"}
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{9}Z$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "media_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"},
    "nullable_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "nullable_timestamp": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "operation": {"enum": ["export", "import", "place_hold", "release_hold", "delete"]},
    "phase": {"enum": ["planned", "quarantined", "verified", "authorized", "packaged", "published", "case_recorded", "tombstoned", "disposed", "custodied", "completed"]},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "artifact_role": {"enum": ["source", "derived", "imported"]},
    "decision_outcome": {"enum": ["allow", "deny"]},
    "decision_reason": {"enum": ["authorized", "invalid_input", "case_not_found", "case_state_denied", "artifact_not_found", "artifact_invalid", "lineage_invalid", "package_invalid", "package_oversized", "media_type_denied", "signature_invalid", "signing_key_invalid", "checkpoint_invalid", "verification_incomplete", "authority_denied", "approval_required", "approval_invalid", "revoked", "stale_actor", "stale_case", "stale_custody", "retention_active", "legal_hold_active", "hold_release_incomplete", "changed_replay", "disposition_failed"]},
    "verification_outcome": {"enum": ["valid", "invalid", "incomplete"]},
    "verification_reason": {"enum": ["verified", "invalid_header", "invalid_schema", "invalid_scope", "invalid_bounds", "invalid_media_type", "compressed_input", "invalid_signature", "unknown_key", "revoked_key", "expired_manifest", "invalid_artifact", "invalid_lineage", "invalid_component", "invalid_custody", "invalid_checkpoint", "trailing_data", "truncated_input"]},
    "case": {
      "type": "object",
      "required": ["organization_id", "tenant_id", "case_id"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/uuid"},
        "tenant_id": {"$ref": "#/$defs/uuid"},
        "case_id": {"$ref": "#/$defs/uuid"}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["digest", "media_type", "classification", "length"],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "media_type": {"$ref": "#/$defs/media_type"},
        "classification": {"$ref": "#/$defs/classification"},
        "length": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      },
      "additionalProperties": false
    },
    "evidence_reference": {
      "type": "object",
      "required": ["artifact", "manifest", "manifest_provenance_digest", "ingestion_receipt_digest"],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "manifest": {"$ref": "#/$defs/artifact"},
        "manifest_provenance_digest": {"$ref": "#/$defs/digest"},
        "ingestion_receipt_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "custody_head": {
      "type": "object",
      "required": ["case", "sequence", "chain_hash", "last_record_at"],
      "properties": {
        "case": {"$ref": "#/$defs/case"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "chain_hash": {"$ref": "#/$defs/digest"},
        "last_record_at": {"$ref": "#/$defs/nullable_timestamp"}
      },
      "additionalProperties": false
    },
    "package_limits": {
      "type": "object",
      "required": ["maximum_manifest_bytes", "maximum_signature_bytes", "maximum_artifacts", "maximum_artifact_bytes", "maximum_package_bytes"],
      "properties": {
        "maximum_manifest_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maximum_signature_bytes": {"type": "integer", "minimum": 64, "maximum": 4096},
        "maximum_artifacts": {"type": "integer", "minimum": 1, "maximum": 4096},
        "maximum_artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "maximum_package_bytes": {"type": "integer", "minimum": 1, "maximum": 4398046511104}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["kind", "name", "version", "digest"],
      "properties": {
        "kind": {"enum": ["policy", "model", "tool", "query", "transform"]},
        "name": {"$ref": "#/$defs/token"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "manifest_artifact": {
      "type": "object",
      "required": ["ordinal", "role", "reference", "parent_artifact_digests", "parent_manifest_digests", "redaction_receipt_digest", "mapping_digest"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 4096},
        "role": {"$ref": "#/$defs/artifact_role"},
        "reference": {"$ref": "#/$defs/evidence_reference"},
        "parent_artifact_digests": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "parent_manifest_digests": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "redaction_receipt_digest": {"$ref": "#/$defs/nullable_digest"},
        "mapping_digest": {"$ref": "#/$defs/nullable_digest"}
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["schema_version", "contract_version", "request_id", "idempotency_key", "operation", "case", "actor_id", "actor_revision", "artifact_set_digest", "package_digest", "source_digest", "purpose_digest", "destination_digest", "reason_digest", "approval_digest", "policy_digest", "expected_case_revision", "expected_custody_head", "limits", "deadline"],
      "properties": {
        "schema_version": {"const": "coh.evidence-lifecycle-command/v1"},
        "contract_version": {"const": "1.0.0"},
        "request_id": {"$ref": "#/$defs/uuid"},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "operation": {"$ref": "#/$defs/operation"},
        "case": {"$ref": "#/$defs/case"},
        "actor_id": {"$ref": "#/$defs/uuid"},
        "actor_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "artifact_set_digest": {"$ref": "#/$defs/nullable_digest"},
        "package_digest": {"$ref": "#/$defs/nullable_digest"},
        "source_digest": {"$ref": "#/$defs/nullable_digest"},
        "purpose_digest": {"$ref": "#/$defs/nullable_digest"},
        "destination_digest": {"$ref": "#/$defs/nullable_digest"},
        "reason_digest": {"$ref": "#/$defs/nullable_digest"},
        "approval_digest": {"$ref": "#/$defs/nullable_digest"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "expected_case_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "expected_custody_head": {"$ref": "#/$defs/custody_head"},
        "limits": {"$ref": "#/$defs/package_limits"},
        "deadline": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "export_manifest": {
      "type": "object",
      "required": ["schema_version", "contract_version", "manifest_id", "package_version", "case", "case_revision", "classification", "actor_id", "actor_revision", "purpose_digest", "destination_digest", "artifacts", "artifact_set_digest", "components", "policy_digest", "decision_digest", "approval_digest", "revocation_digest", "custody_from_sequence", "custody_to_sequence", "custody_report_digest", "audit_checkpoint_id", "audit_checkpoint_digest", "audit_checkpoint_sequence", "audit_signing_key_revision", "audit_proof_digest", "signing_algorithm", "signing_key_id", "signing_key_revision", "signing_trust_snapshot_digest", "signing_key_revocation_digest", "compression", "limits", "created_at", "valid_until", "idempotency_digest", "previous_provenance_digest", "manifest_digest"],
      "properties": {
        "schema_version": {"const": "coh.evidence-export-manifest/v1"},
        "contract_version": {"const": "1.0.0"},
        "manifest_id": {"$ref": "#/$defs/uuid"},
        "package_version": {"const": "coh.evidence-package/v1"},
        "case": {"$ref": "#/$defs/case"},
        "case_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "classification": {"$ref": "#/$defs/classification"},
        "actor_id": {"$ref": "#/$defs/uuid"},
        "actor_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "purpose_digest": {"$ref": "#/$defs/digest"},
        "destination_digest": {"$ref": "#/$defs/digest"},
        "artifacts": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/manifest_artifact"}},
        "artifact_set_digest": {"$ref": "#/$defs/digest"},
        "components": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/component"}},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "decision_digest": {"$ref": "#/$defs/digest"},
        "approval_digest": {"$ref": "#/$defs/digest"},
        "revocation_digest": {"$ref": "#/$defs/digest"},
        "custody_from_sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "custody_to_sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "custody_report_digest": {"$ref": "#/$defs/digest"},
        "audit_checkpoint_id": {"$ref": "#/$defs/uuid"},
        "audit_checkpoint_digest": {"$ref": "#/$defs/digest"},
        "audit_checkpoint_sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "audit_signing_key_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "audit_proof_digest": {"$ref": "#/$defs/digest"},
        "signing_algorithm": {"const": "ed25519"},
        "signing_key_id": {"$ref": "#/$defs/token"},
        "signing_key_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "signing_trust_snapshot_digest": {"$ref": "#/$defs/digest"},
        "signing_key_revocation_digest": {"$ref": "#/$defs/digest"},
        "compression": {"const": "none"},
        "limits": {"$ref": "#/$defs/package_limits"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "valid_until": {"$ref": "#/$defs/timestamp"},
        "idempotency_digest": {"$ref": "#/$defs/digest"},
        "previous_provenance_digest": {"$ref": "#/$defs/digest"},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "detached_signature": {
      "type": "object",
      "required": ["schema_version", "contract_version", "algorithm", "key_id", "key_revision", "manifest_digest", "signature"],
      "properties": {
        "schema_version": {"const": "coh.evidence-detached-signature/v1"},
        "contract_version": {"const": "1.0.0"},
        "algorithm": {"const": "ed25519"},
        "key_id": {"$ref": "#/$defs/token"},
        "key_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      },
      "additionalProperties": false
    },
    "package_header": {
      "type": "object",
      "required": ["schema_version", "contract_version", "magic", "package_version", "compression", "manifest_length", "signature_length", "artifact_count", "package_length", "header_digest"],
      "properties": {
        "schema_version": {"const": "coh.evidence-package-header/v1"},
        "contract_version": {"const": "1.0.0"},
        "magic": {"const": "COHEVPKG1"},
        "package_version": {"const": "coh.evidence-package/v1"},
        "compression": {"const": "none"},
        "manifest_length": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "signature_length": {"type": "integer", "minimum": 64, "maximum": 4096},
        "artifact_count": {"type": "integer", "minimum": 1, "maximum": 4096},
        "package_length": {"type": "integer", "minimum": 1, "maximum": 4398046511104},
        "header_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "import_verification": {
      "type": "object",
      "required": ["schema_version", "contract_version", "verification_id", "source_digest", "package_digest", "header_digest", "manifest_digest", "signature_digest", "signing_key_id", "signing_key_revision", "trust_snapshot_digest", "revocation_digest", "artifact_set_digest", "lineage_digest", "component_set_digest", "custody_report_digest", "audit_checkpoint_digest", "outcome", "reason_code", "verified_at", "report_digest"],
      "properties": {
        "schema_version": {"const": "coh.evidence-import-verification/v1"},
        "contract_version": {"const": "1.0.0"},
        "verification_id": {"$ref": "#/$defs/uuid"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "package_digest": {"$ref": "#/$defs/digest"},
        "header_digest": {"$ref": "#/$defs/digest"},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "signing_key_id": {"$ref": "#/$defs/token"},
        "signing_key_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "trust_snapshot_digest": {"$ref": "#/$defs/digest"},
        "revocation_digest": {"$ref": "#/$defs/digest"},
        "artifact_set_digest": {"$ref": "#/$defs/digest"},
        "lineage_digest": {"$ref": "#/$defs/digest"},
        "component_set_digest": {"$ref": "#/$defs/digest"},
        "custody_report_digest": {"$ref": "#/$defs/digest"},
        "audit_checkpoint_digest": {"$ref": "#/$defs/digest"},
        "outcome": {"$ref": "#/$defs/verification_outcome"},
        "reason_code": {"$ref": "#/$defs/verification_reason"},
        "verified_at": {"$ref": "#/$defs/timestamp"},
        "report_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "authorization_request": {
      "type": "object",
      "required": ["schema_version", "contract_version", "authorization_digest", "intent_digest", "command", "case_state", "case_classification", "case_revision", "retain_until", "legal_hold", "hold_release_pending", "case_provenance_digest", "artifact_set_digest", "verification_report_digest", "current_custody_head", "progress_digest"],
      "properties": {
        "schema_version": {"const": "coh.evidence-lifecycle-authorization/v1"},
        "contract_version": {"const": "1.0.0"},
        "authorization_digest": {"$ref": "#/$defs/digest"},
        "intent_digest": {"$ref": "#/$defs/digest"},
        "command": {"$ref": "#/$defs/command"},
        "case_state": {"enum": ["open", "closed", "deleted"]},
        "case_classification": {"$ref": "#/$defs/classification"},
        "case_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "retain_until": {"$ref": "#/$defs/timestamp"},
        "legal_hold": {"type": "boolean"},
        "hold_release_pending": {"type": "boolean"},
        "case_provenance_digest": {"$ref": "#/$defs/digest"},
        "artifact_set_digest": {"$ref": "#/$defs/nullable_digest"},
        "verification_report_digest": {"$ref": "#/$defs/nullable_digest"},
        "current_custody_head": {"$ref": "#/$defs/custody_head"},
        "progress_digest": {"$ref": "#/$defs/nullable_digest"}
      },
      "additionalProperties": false
    },
    "decision": {
