        "intent_digest": {"$ref": "#/$defs/digest"},
        "decision_digest": {"$ref": "#/$defs/nullable_digest"},
        "revocation_digest": {"$ref": "#/$defs/nullable_digest"},
        "package_digest": {"$ref": "#/$defs/nullable_digest"},
        "manifest_digest": {"$ref": "#/$defs/nullable_digest"},
        "signature_digest": {"$ref": "#/$defs/nullable_digest"},
        "verification_report_digest": {"$ref": "#/$defs/nullable_digest"},
        "lifecycle_receipt_digest": {"$ref": "#/$defs/nullable_digest"},
        "authorization_custody_receipt_digest": {"$ref": "#/$defs/nullable_digest"},
        "completion_custody_receipt_digest": {"$ref": "#/$defs/nullable_digest"},
        "disposition_attestation_digest": {"$ref": "#/$defs/nullable_digest"},
        "artifacts": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/artifact_progress"}},
        "updated_at": {"$ref": "#/$defs/timestamp"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "progress_digest": {"$ref": "#/$defs/digest"}
      },
