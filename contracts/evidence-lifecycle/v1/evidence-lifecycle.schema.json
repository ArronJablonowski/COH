      "required": ["schema_version", "contract_version", "decision_id", "decision_digest", "authorization_digest", "intent_digest", "operation", "case", "actor_id", "actor_revision", "artifact_set_digest", "package_digest", "policy_digest", "approval_digest", "revocation_digest", "expected_case_revision", "expected_custody_head", "outcome", "reason_code", "issued_at", "expires_at", "revision"],
      "properties": {
        "schema_version": {"const": "coh.evidence-lifecycle-decision/v1"},
        "contract_version": {"const": "1.0.0"},
        "decision_id": {"$ref": "#/$defs/uuid"},
        "decision_digest": {"$ref": "#/$defs/digest"},
        "authorization_digest": {"$ref": "#/$defs/digest"},
        "intent_digest": {"$ref": "#/$defs/digest"},
        "operation": {"$ref": "#/$defs/operation"},
        "case": {"$ref": "#/$defs/case"},
        "actor_id": {"$ref": "#/$defs/uuid"},
        "actor_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "artifact_set_digest": {"$ref": "#/$defs/nullable_digest"},
        "package_digest": {"$ref": "#/$defs/nullable_digest"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "approval_digest": {"$ref": "#/$defs/nullable_digest"},
        "revocation_digest": {"$ref": "#/$defs/digest"},
        "expected_case_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "expected_custody_head": {"$ref": "#/$defs/custody_head"},
        "outcome": {"$ref": "#/$defs/decision_outcome"},
        "reason_code": {"$ref": "#/$defs/decision_reason"},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      },
      "additionalProperties": false
    },
    "artifact_progress": {
      "type": "object",
      "required": ["ordinal", "artifact_digest", "ingestion_receipt_digest", "custody_receipt_digest"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 4096},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "ingestion_receipt_digest": {"$ref": "#/$defs/nullable_digest"},
        "custody_receipt_digest": {"$ref": "#/$defs/nullable_digest"}
