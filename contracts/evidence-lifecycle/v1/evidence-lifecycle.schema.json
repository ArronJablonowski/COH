    },
    "disposition_object": {
      "type": "object",
      "required": ["ordinal", "artifact_digest", "encrypted_object_digest", "key_revision", "outcome", "outcome_digest"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 8192},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "encrypted_object_digest": {"$ref": "#/$defs/digest"},
