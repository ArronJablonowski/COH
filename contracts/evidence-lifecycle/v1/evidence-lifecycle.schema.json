      "required": ["schema_version", "contract_version", "attestation_id", "case", "operation_id", "artifact_set_digest", "authorization_custody_receipt_digest", "lifecycle_receipt_digest", "mechanism", "objects", "attempted_at", "completed_at", "attestation_digest"],
      "properties": {
        "schema_version": {"const": "coh.evidence-disposition-attestation/v1"},
        "contract_version": {"const": "1.0.0"},
        "attestation_id": {"$ref": "#/$defs/uuid"},
