{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.local/contracts/audit/v1/audit-record.schema.json",
  "title": "COH hash-chained audit record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "organization_id",
    "tenant_id",
    "sequence",
    "event",
    "event_digest",
    "previous_chain_hash",
    "chain_hash",
    "appended_at"
  ],
  "properties": {
    "schema_version": {"const": "coh.audit-record/v1"},
    "contract_version": {"const": "1.0.0"},
    "organization_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "tenant_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "event": {"$ref": "audit-event.schema.json"},
    "event_digest": {"$ref": "#/$defs/digest"},
    "previous_chain_hash": {"$ref": "#/$defs/digest"},
    "chain_hash": {"$ref": "#/$defs/digest"},
    "appended_at": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{9}Z$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
