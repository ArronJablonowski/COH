{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.local/contracts/audit/v1/audit-checkpoint.schema.json",
  "title": "COH signed audit checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "checkpoint_id",
    "organization_id",
    "tenant_id",
    "covered_from_sequence",
    "sequence",
    "record_count",
    "chain_hash",
    "reason",
    "signing_key_id",
    "signing_key_revision",
    "signature_algorithm",
    "created_at",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "coh.audit-checkpoint/v1"},
    "contract_version": {"const": "1.0.0"},
    "checkpoint_id": {"$ref": "#/$defs/uuid7"},
    "organization_id": {"$ref": "#/$defs/uuid7"},
    "tenant_id": {"$ref": "#/$defs/uuid7"},
    "covered_from_sequence": {"type": "integer", "minimum": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "record_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "chain_hash": {"$ref": "#/$defs/digest"},
    "reason": {"enum": ["daily", "record_limit", "manual_final"]},
    "signing_key_id": {"$ref": "#/$defs/token"},
    "signing_key_revision": {"type": "integer", "minimum": 1},
    "signature_algorithm": {"const": "ed25519"},
    "created_at": {"$ref": "#/$defs/time"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "$defs": {
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{9}Z$"}
  }
}
