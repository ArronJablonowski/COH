{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.local/contracts/audit/v1/audit-event.schema.json",
  "title": "COH redacted audit event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "event_id",
    "organization_id",
    "tenant_id",
    "source_schema",
    "operation",
    "outcome",
    "reason_code",
    "evidence_digests"
  ],
  "properties": {
    "schema_version": {"const": "coh.audit-event/v1"},
    "contract_version": {"const": "1.0.0"},
    "event_id": {"oneOf": [{"$ref": "#/$defs/uuid7"}, {"$ref": "#/$defs/digest"}]},
    "organization_id": {"$ref": "#/$defs/uuid7"},
    "tenant_id": {"$ref": "#/$defs/uuid7"},
    "case_id": {"$ref": "#/$defs/uuid7"},
    "actor_id": {"$ref": "#/$defs/uuid7"},
    "actor_revision": {"type": "integer", "minimum": 1},
    "source_schema": {"type": "string", "pattern": "^coh\\.[a-z][a-z0-9.-]*/v[1-9][0-9]*$"},
    "operation": {"$ref": "#/$defs/token"},
    "outcome": {"$ref": "#/$defs/token"},
    "reason_code": {"$ref": "#/$defs/token"},
    "subject_id": {"$ref": "#/$defs/uuid7"},
    "subject_revision": {"type": "integer", "minimum": 1},
    "subject_digest": {"$ref": "#/$defs/digest"},
    "evidence_digests": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "occurred_at": {"$ref": "#/$defs/time"}
  },
  "dependentRequired": {
    "actor_id": ["actor_revision"],
    "actor_revision": ["actor_id"],
    "subject_revision": ["subject_id"]
  },
  "$defs": {
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{9}Z$"}
  }
}
