{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/model-surface/v1/model-surface-stream.schema.json",
  "title": "COH model-surface stream lineage event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "request_id", "attempt_id", "binding_digest", "projection_digest", "input_surface_digest", "sequence", "kind", "source_record_ids", "chunk_digest", "assembled_digest", "outcome", "observed_at", "event_digest"],
  "properties": {
    "schema_version": {"const": "coh.model-surface-stream/v1"},
    "contract_version": {"const": "1.0.0"},
    "request_id": {"$ref": "#/$defs/uuid7"},
    "attempt_id": {"$ref": "#/$defs/uuid7"},
    "binding_digest": {"$ref": "#/$defs/digest"},
    "projection_digest": {"$ref": "#/$defs/digest"},
    "input_surface_digest": {"$ref": "#/$defs/digest"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "kind": {"enum": ["started", "chunk", "item", "terminal"]},
    "source_record_ids": {
      "type": "array", "minItems": 1, "maxItems": 16384, "uniqueItems": true,
      "items": {"$ref": "#/$defs/uuid7"}
    },
    "chunk_digest": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/digest"}]},
    "assembled_digest": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/digest"}]},
    "outcome": {"enum": ["pending", "succeeded", "empty", "interrupted", "canceled", "timeout", "failed", "uncertain"]},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "event_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"enum": ["started", "chunk", "item"]}}},
      "then": {"properties": {"outcome": {"const": "pending"}, "assembled_digest": {"const": ""}}}
    },
    {
      "if": {"properties": {"kind": {"const": "terminal"}}},
      "then": {
        "properties": {
          "outcome": {"not": {"const": "pending"}},
          "assembled_digest": {"$ref": "#/$defs/digest"}
        }
      }
    }
  ],
  "$defs": {
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{9}Z$"}
  }
}
