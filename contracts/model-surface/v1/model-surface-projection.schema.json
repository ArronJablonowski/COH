{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/model-surface/v1/model-surface-projection.schema.json",
  "title": "COH deterministic model-surface projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "projection_id", "projection_version", "scope", "run_id", "vocabulary_digest", "composition_digest", "ordered_items", "ordered_source_record_ids", "artifact_digests", "surface_digest", "projection_digest", "created_at"],
  "properties": {
    "schema_version": {"const": "coh.model-surface-projection/v1"},
    "contract_version": {"const": "1.0.0"},
    "projection_id": {"$ref": "#/$defs/uuid7"},
    "projection_version": {"const": "1.0.0"},
    "scope": {"$ref": "#/$defs/scope"},
    "run_id": {"$ref": "#/$defs/uuid7"},
    "vocabulary_digest": {"$ref": "#/$defs/digest"},
    "composition_digest": {"$ref": "#/$defs/digest"},
    "ordered_items": {
      "type": "array", "minItems": 1, "maxItems": 16384,
      "items": {"$ref": "#/$defs/projected_item"}
    },
    "ordered_source_record_ids": {
      "type": "array", "minItems": 1, "maxItems": 16384,
      "items": {"$ref": "#/$defs/uuid7"}
    },
    "artifact_digests": {
      "type": "array", "maxItems": 16384, "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "surface_digest": {"$ref": "#/$defs/digest"},
    "projection_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{9}Z$"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["organization_id", "tenant_id", "case_id", "task_id"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/uuid7"},
        "tenant_id": {"$ref": "#/$defs/uuid7"},
        "case_id": {"$ref": "#/$defs/uuid7"},
        "task_id": {"$ref": "#/$defs/uuid7"}
      }
    },
    "projected_item": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "surface_kind", "role", "source_record_id", "source_revision", "source_digest", "content_kind", "content_id", "content_digest", "rendered_digest", "rendered_length", "instruction_disposition"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 16384},
        "surface_kind": {"enum": ["message", "prompt_section", "tool_schema", "retrieved_context", "compaction_replacement", "policy_notice"]},
        "role": {"enum": ["system", "developer", "user", "assistant", "tool", "data"]},
        "source_record_id": {"$ref": "#/$defs/uuid7"},
        "source_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "source_digest": {"$ref": "#/$defs/digest"},
        "content_kind": {"enum": ["durable_record", "immutable_artifact"]},
        "content_id": {"$ref": "#/$defs/token"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "rendered_digest": {"$ref": "#/$defs/digest"},
        "rendered_length": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "instruction_disposition": {"enum": ["trusted_control_instruction", "trusted_system_instruction", "trusted_user_instruction", "untrusted_data_only"]}
      }
    }
  }
}
