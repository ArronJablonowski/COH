{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/model-surface/v1/compaction-replacement.schema.json",
  "title": "COH source-covering model-surface compaction replacement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "replacement_id", "scope", "run_id", "compaction_id", "replacement_source_record_id", "covered_sources", "summary_artifact", "coverage_digest", "replacement_digest", "created_at"],
  "properties": {
    "schema_version": {"const": "coh.model-surface-compaction-replacement/v1"},
    "contract_version": {"const": "1.0.0"},
    "replacement_id": {"$ref": "#/$defs/uuid7"},
    "scope": {"$ref": "#/$defs/scope"},
    "run_id": {"$ref": "#/$defs/uuid7"},
    "compaction_id": {"$ref": "#/$defs/uuid7"},
    "replacement_source_record_id": {"$ref": "#/$defs/uuid7"},
    "covered_sources": {
      "type": "array", "minItems": 1, "maxItems": 16384,
      "items": {"$ref": "#/$defs/covered_source"}
    },
    "summary_artifact": {"$ref": "#/$defs/artifact"},
    "coverage_digest": {"$ref": "#/$defs/digest"},
    "replacement_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{9}Z$"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["organization_id", "tenant_id", "case_id", "task_id"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/uuid7"},
        "tenant_id": {"$ref": "#/$defs/uuid7"},
        "case_id": {"$ref": "#/$defs/uuid7"},
        "task_id": {"$ref": "#/$defs/uuid7"}
      }
    },
    "covered_source": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "source_record_id", "source_digest", "evidence_ids", "normalized_time", "original_timezone", "precision", "clock_uncertainty_nanoseconds", "order_confidence", "result_state", "completeness", "uncertainty"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 16384},
        "source_record_id": {"$ref": "#/$defs/uuid7"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "evidence_ids": {
          "type": "array", "maxItems": 4096, "uniqueItems": true,
          "items": {"$ref": "#/$defs/uuid7"}
        },
        "normalized_time": {"$ref": "#/$defs/timestamp"},
        "original_timezone": {"type": "string", "minLength": 1, "maxLength": 128},
        "precision": {"enum": ["nanosecond", "microsecond", "millisecond", "second", "minute", "hour", "day", "unknown"]},
        "clock_uncertainty_nanoseconds": {"type": "integer", "minimum": 0, "maximum": 315576000000000000},
        "order_confidence": {"enum": ["strict", "overlap", "ambiguous", "unknown"]},
        "result_state": {"enum": ["observed", "negative", "gap", "denied", "canceled", "timeout", "failed", "uncertain"]},
        "completeness": {"enum": ["complete", "partial", "truncated", "unknown"]},
        "uncertainty": {"enum": ["none", "clock", "bounded", "source", "unknown"]}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "digest", "media_type", "length", "classification", "immutable"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/token"},
        "digest": {"$ref": "#/$defs/digest"},
        "media_type": {"enum": ["application/json", "text/markdown", "text/plain"]},
        "length": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "classification": {"enum": ["public", "internal", "restricted", "confidential"]},
        "immutable": {"const": true}
      }
    }
  }
}
