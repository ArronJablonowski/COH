{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/model-surface/v1/model-surface-payload.schema.json",
  "title": "COH model-surface content payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "surface_kind", "role", "name", "content_kind", "content"],
  "properties": {
    "schema_version": {"const": "coh.model-surface-payload/v1"},
    "contract_version": {"const": "1.0.0"},
    "surface_kind": {"enum": ["message", "prompt_section", "tool_schema", "retrieved_context", "compaction_replacement", "policy_notice"]},
    "role": {"enum": ["system", "developer", "user", "assistant", "tool", "data"]},
    "name": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/token"}]},
    "content_kind": {"enum": ["text", "input_json", "output_json", "tool_call", "tool_result", "reasoning_ref", "tool_definition"]},
    "content": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 8388608},
        {"$ref": "#/$defs/json_content"},
        {"$ref": "#/$defs/tool_call"},
        {"$ref": "#/$defs/tool_result"},
        {"$ref": "#/$defs/reasoning_ref"},
        {"$ref": "#/$defs/tool_definition"}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"content_kind": {"const": "text"}}}, "then": {"properties": {"content": {"type": "string"}}}},
    {"if": {"properties": {"content_kind": {"enum": ["input_json", "output_json"]}}}, "then": {"properties": {"content": {"$ref": "#/$defs/json_content"}}}},
    {"if": {"properties": {"content_kind": {"const": "tool_call"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/tool_call"}}}},
    {"if": {"properties": {"content_kind": {"const": "tool_result"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/tool_result"}}}},
    {"if": {"properties": {"content_kind": {"const": "reasoning_ref"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/reasoning_ref"}}}},
    {"if": {"properties": {"content_kind": {"const": "tool_definition"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/tool_definition"}}}},
    {
      "if": {"properties": {"surface_kind": {"const": "message"}}},
      "then": {
        "properties": {"name": {"const": ""}},
        "allOf": [
          {"if": {"properties": {"role": {"enum": ["system", "developer", "user"]}}}, "then": {"properties": {"content_kind": {"enum": ["text", "input_json"]}}}},
          {"if": {"properties": {"role": {"const": "assistant"}}}, "then": {"properties": {"content_kind": {"enum": ["text", "output_json", "tool_call", "reasoning_ref"]}}}},
          {"if": {"properties": {"role": {"const": "tool"}}}, "then": {"properties": {"content_kind": {"const": "tool_result"}}}},
          {"not": {"properties": {"role": {"const": "data"}}, "required": ["role"]}}
        ]
      }
    },
    {
      "if": {"properties": {"surface_kind": {"enum": ["prompt_section", "policy_notice"]}}},
      "then": {"properties": {"role": {"enum": ["system", "developer"]}, "content_kind": {"enum": ["text", "input_json"]}}}
    },
    {
      "if": {"properties": {"surface_kind": {"const": "tool_schema"}}},
      "then": {"properties": {"role": {"enum": ["system", "developer"]}, "name": {"$ref": "#/$defs/token"}, "content_kind": {"const": "tool_definition"}, "content": {"$ref": "#/$defs/tool_definition"}}}
    },
    {
      "if": {"properties": {"surface_kind": {"enum": ["retrieved_context", "compaction_replacement"]}}},
      "then": {"properties": {"role": {"const": "data"}, "content_kind": {"enum": ["text", "input_json"]}}}
    }
  ],
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bounded_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "json_content": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "schema_digest"],
      "properties": {"value": {"type": "object"}, "schema_digest": {"$ref": "#/$defs/digest"}}
    },
    "tool_call": {
      "type": "object", "additionalProperties": false,
      "required": ["call_id", "tool_name", "arguments", "input_schema_digest"],
      "properties": {
        "call_id": {"$ref": "#/$defs/bounded_id"}, "tool_name": {"$ref": "#/$defs/token"},
        "arguments": {"type": "object"}, "input_schema_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "tool_result": {
      "type": "object", "additionalProperties": false,
      "required": ["call_id", "outcome", "value", "output_schema_digest", "result_digest"],
      "properties": {
        "call_id": {"$ref": "#/$defs/bounded_id"},
        "outcome": {"enum": ["succeeded", "denied", "canceled", "timeout", "failed", "uncertain"]},
        "value": {"type": "object"}, "output_schema_digest": {"$ref": "#/$defs/digest"},
        "result_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "reasoning_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_id", "digest"],
      "properties": {"reference_id": {"type": "string", "minLength": 1, "maxLength": 256}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "tool_definition": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "input_schema_digest", "output_schema_digest"],
      "properties": {
        "description": {"type": "string", "minLength": 1, "maxLength": 4096},
        "input_schema_digest": {"$ref": "#/$defs/digest"}, "output_schema_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
