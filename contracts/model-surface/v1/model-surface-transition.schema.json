{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/model-surface/v1/model-surface-transition.schema.json",
  "title": "COH durable model-surface projection transition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "transition_id", "request_id", "attempt_id", "scope", "run_id", "phase", "revision", "projection_digest", "binding_digest", "provider_route", "provider_attempt", "stream_cursor", "terminal_outcome", "previous_transition_digest", "transition_digest", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "coh.model-surface-transition/v1"},
    "contract_version": {"const": "1.0.0"},
    "transition_id": {"$ref": "#/$defs/uuid7"},
    "request_id": {"$ref": "#/$defs/uuid7"},
    "attempt_id": {"$ref": "#/$defs/uuid7"},
    "scope": {"$ref": "#/$defs/scope"},
    "run_id": {"$ref": "#/$defs/uuid7"},
    "phase": {"enum": ["prepared", "verified", "dispatched", "streaming", "terminal"]},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "projection_digest": {"$ref": "#/$defs/digest"},
    "binding_digest": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/digest"}]},
    "provider_route": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "provider_attempt": {"type": "integer", "minimum": 1, "maximum": 32},
    "stream_cursor": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "terminal_outcome": {"enum": ["", "succeeded", "empty", "interrupted", "canceled", "timeout", "failed", "uncertain"]},
    "previous_transition_digest": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/digest"}]},
    "transition_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "prepared"}}},
      "then": {"properties": {"binding_digest": {"const": ""}, "terminal_outcome": {"const": ""}}}
    },
    {
      "if": {"properties": {"phase": {"enum": ["verified", "dispatched", "streaming"]}}},
      "then": {"properties": {"binding_digest": {"$ref": "#/$defs/digest"}, "terminal_outcome": {"const": ""}}}
    },
    {
      "if": {"properties": {"phase": {"const": "terminal"}}},
      "then": {
        "properties": {
          "binding_digest": {"$ref": "#/$defs/digest"},
          "terminal_outcome": {"not": {"const": ""}}
        }
      }
    }
  ],
  "$defs": {
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{9}Z$"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["organization_id", "tenant_id", "case_id", "task_id"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/uuid7"},
        "tenant_id": {"$ref": "#/$defs/uuid7"},
        "case_id": {"$ref": "#/$defs/uuid7"},
        "task_id": {"$ref": "#/$defs/uuid7"}
      }
    }
  }
}
