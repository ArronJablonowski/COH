{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/model-surface/v1/inference-surface-binding.schema.json",
  "title": "COH inference model-surface binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "request_id", "attempt_id", "scope", "run_id", "actor_id", "provider_id", "projection_id", "projection_version", "projection_digest", "ordered_source_record_ids", "artifact_digests", "vocabulary_digest", "composition_digest", "surface_digest", "authorization_digest", "policy_decision_digest", "approval_decision_digest", "audit_reservation_digest", "binding_digest", "created_at", "deadline"],
  "properties": {
    "schema_version": {"const": "coh.inference-surface-binding/v1"},
    "contract_version": {"const": "1.0.0"},
    "request_id": {"$ref": "#/$defs/uuid7"},
    "attempt_id": {"$ref": "#/$defs/uuid7"},
    "scope": {"$ref": "#/$defs/scope"},
    "run_id": {"$ref": "#/$defs/uuid7"},
    "actor_id": {"$ref": "#/$defs/uuid7"},
    "provider_id": {"$ref": "#/$defs/token"},
    "projection_id": {"$ref": "#/$defs/uuid7"},
    "projection_version": {"const": "1.0.0"},
    "projection_digest": {"$ref": "#/$defs/digest"},
    "ordered_source_record_ids": {
      "type": "array", "minItems": 1, "maxItems": 16384,
      "items": {"$ref": "#/$defs/uuid7"}
    },
    "artifact_digests": {
      "type": "array", "maxItems": 16384, "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "vocabulary_digest": {"$ref": "#/$defs/digest"},
    "composition_digest": {"$ref": "#/$defs/digest"},
    "surface_digest": {"$ref": "#/$defs/digest"},
    "authorization_digest": {"$ref": "#/$defs/digest"},
    "policy_decision_digest": {"$ref": "#/$defs/digest"},
    "approval_decision_digest": {"$ref": "#/$defs/digest"},
    "audit_reservation_digest": {"$ref": "#/$defs/digest"},
    "binding_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "deadline": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{9}Z$"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["organization_id", "tenant_id", "case_id", "task_id"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/uuid7"},
        "tenant_id": {"$ref": "#/$defs/uuid7"},
        "case_id": {"$ref": "#/$defs/uuid7"},
        "task_id": {"$ref": "#/$defs/uuid7"}
      }
    }
  }
}
