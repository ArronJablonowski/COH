{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/query/v1/query-connector.schema.json",
  "title": "COH read-only query connector contract v1",
  "oneOf": [
    {"$ref":"#/$defs/capability"},
    {"$ref":"#/$defs/query"},
    {"$ref":"#/$defs/validation"},
    {"$ref":"#/$defs/execution"},
    {"$ref":"#/$defs/schema_page"},
    {"$ref":"#/$defs/poll"},
    {"$ref":"#/$defs/page"},
    {"$ref":"#/$defs/cancellation"}
  ],
  "$defs": {
    "uuid_v7":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "token":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},
    "timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"},
    "tokens":{"type":"array","minItems":1,"maxItems":4096,"uniqueItems":true,"items":{"$ref":"#/$defs/token"}},
    "reasons":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"}},
    "scope":{"type":"object","additionalProperties":false,"required":["organization_id","tenant_id","case_id","source_id","resource_ids"],"properties":{"organization_id":{"$ref":"#/$defs/uuid_v7"},"tenant_id":{"$ref":"#/$defs/uuid_v7"},"case_id":{"$ref":"#/$defs/uuid_v7"},"source_id":{"$ref":"#/$defs/token"},"resource_ids":{"$ref":"#/$defs/tokens"}}},
    "authority":{"type":"object","additionalProperties":false,"required":["actor_id","authorization_digest","policy_decision_digest","audit_reservation_digest"],"properties":{"actor_id":{"$ref":"#/$defs/uuid_v7"},"authorization_digest":{"$ref":"#/$defs/digest"},"policy_decision_digest":{"$ref":"#/$defs/digest"},"audit_reservation_digest":{"$ref":"#/$defs/digest"}}},
    "time_range":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"$ref":"#/$defs/timestamp"},"end":{"$ref":"#/$defs/timestamp"}}},
    "limits":{"type":"object","additionalProperties":false,"required":["maximum_rows","maximum_bytes","maximum_duration_millis","maximum_pages","maximum_slices","maximum_cost_millionths","requests_per_minute"],"properties":{"maximum_rows":{"type":"integer","minimum":1},"maximum_bytes":{"type":"integer","minimum":1},"maximum_duration_millis":{"type":"integer","minimum":1},"maximum_pages":{"type":"integer","minimum":1},"maximum_slices":{"type":"integer","minimum":1},"maximum_cost_millionths":{"type":"integer","minimum":1},"requests_per_minute":{"type":"integer","minimum":1}}},
    "features":{"type":"object","additionalProperties":false,"required":["read_only","schema_discovery","validation","polling","paging","cancellation","statistics"],"properties":{"read_only":{"const":true},"schema_discovery":{"type":"boolean"},"validation":{"type":"boolean"},"polling":{"type":"boolean"},"paging":{"type":"boolean"},"cancellation":{"type":"boolean"},"statistics":{"type":"boolean"}}},
    "handle":{"type":"object","additionalProperties":false,"required":["handle_id","kind","source_id","opaque_digest","issued_at","expires_at"],"properties":{"handle_id":{"$ref":"#/$defs/uuid_v7"},"kind":{"enum":["schema_cursor","query_job","result_page"]},"source_id":{"$ref":"#/$defs/token"},"opaque_digest":{"$ref":"#/$defs/digest"},"issued_at":{"$ref":"#/$defs/timestamp"},"expires_at":{"$ref":"#/$defs/timestamp"}}},
    "nullable_handle":{"oneOf":[{"$ref":"#/$defs/handle"},{"type":"null"}]},
    "statistics":{"type":"object","additionalProperties":false,"required":["rows_scanned","rows_returned","bytes_returned","duration_millis","pages_returned","slices_completed","cost_millionths"],"properties":{"rows_scanned":{"type":"integer","minimum":0},"rows_returned":{"type":"integer","minimum":0},"bytes_returned":{"type":"integer","minimum":0},"duration_millis":{"type":"integer","minimum":0},"pages_returned":{"type":"integer","minimum":1},"slices_completed":{"type":"integer","minimum":1},"cost_millionths":{"type":"integer","minimum":0}}},
    "completeness":{"type":"object","additionalProperties":false,"required":["status","reason_codes","truncated","partial","vendor_confirmed"],"properties":{"status":{"enum":["complete","partial","unknown"]},"reason_codes":{"$ref":"#/$defs/reasons"},"truncated":{"type":"boolean"},"partial":{"type":"boolean"},"vendor_confirmed":{"type":"boolean"}}},
    "schema_entry":{"type":"object","additionalProperties":false,"required":["resource_id","name","type","nullable"],"properties":{"resource_id":{"$ref":"#/$defs/token"},"name":{"$ref":"#/$defs/token"},"type":{"enum":["string","integer","boolean","timestamp","ip","bytes","object"]},"nullable":{"type":"boolean"}}},
    "capability":{"type":"object","additionalProperties":false,"required":["schema_version","contract_version","snapshot_id","source_id","adapter_version","observed_at","valid_until","query_languages","features","hard_limits","source_identity_digest"],"properties":{"schema_version":{"const":"coh.query-capability/v1"},"contract_version":{"const":"1.0.0"},"snapshot_id":{"$ref":"#/$defs/uuid_v7"},"source_id":{"$ref":"#/$defs/token"},"adapter_version":{"$ref":"#/$defs/token"},"observed_at":{"$ref":"#/$defs/timestamp"},"valid_until":{"$ref":"#/$defs/timestamp"},"query_languages":{"$ref":"#/$defs/tokens"},"features":{"$ref":"#/$defs/features"},"hard_limits":{"$ref":"#/$defs/limits"},"source_identity_digest":{"$ref":"#/$defs/digest"}}},
    "query":{"type":"object","additionalProperties":false,"required":["schema_version","contract_version","query_id","scope","authority","capability_digest","schema_digest","language","native_text","time_range","limits","requested_at","deadline"],"properties":{"schema_version":{"const":"coh.query-request/v1"},"contract_version":{"const":"1.0.0"},"query_id":{"$ref":"#/$defs/uuid_v7"},"scope":{"$ref":"#/$defs/scope"},"authority":{"$ref":"#/$defs/authority"},"capability_digest":{"$ref":"#/$defs/digest"},"schema_digest":{"$ref":"#/$defs/digest"},"language":{"$ref":"#/$defs/token"},"native_text":{"type":"string","minLength":1,"maxLength":262144},"time_range":{"$ref":"#/$defs/time_range"},"limits":{"$ref":"#/$defs/limits"},"requested_at":{"$ref":"#/$defs/timestamp"},"deadline":{"$ref":"#/$defs/timestamp"}}},
    "validation":{"type":"object","additionalProperties":false,"required":["schema_version","contract_version","query_id","outcome","reason_codes","validator_version","canonical_query_digest","provenance_digest"],"properties":{"schema_version":{"const":"coh.query-validation/v1"},"contract_version":{"const":"1.0.0"},"query_id":{"$ref":"#/$defs/uuid_v7"},"outcome":{"enum":["accepted","denied"]},"reason_codes":{"$ref":"#/$defs/reasons"},"validator_version":{"$ref":"#/$defs/token"},"canonical_query_digest":{"$ref":"#/$defs/digest"},"provenance_digest":{"$ref":"#/$defs/digest"}}},
    "execution":{"type":"object","additionalProperties":false,"required":["schema_version","contract_version","query_id","attempt_id","handle","outcome","started_at","provenance_digest"],"properties":{"schema_version":{"const":"coh.query-execution/v1"},"contract_version":{"const":"1.0.0"},"query_id":{"$ref":"#/$defs/uuid_v7"},"attempt_id":{"$ref":"#/$defs/uuid_v7"},"handle":{"$ref":"#/$defs/handle"},"outcome":{"enum":["queued","running"]},"started_at":{"$ref":"#/$defs/timestamp"},"provenance_digest":{"$ref":"#/$defs/digest"}}},
    "schema_page":{"type":"object","additionalProperties":false,"required":["schema_version","contract_version","request_id","schema_digest","entries","next_cursor","complete","provenance_digest"],"properties":{"schema_version":{"const":"coh.query-schema/v1"},"contract_version":{"const":"1.0.0"},"request_id":{"$ref":"#/$defs/uuid_v7"},"schema_digest":{"$ref":"#/$defs/digest"},"entries":{"type":"array","minItems":1,"maxItems":4096,"items":{"$ref":"#/$defs/schema_entry"}},"next_cursor":{"$ref":"#/$defs/nullable_handle"},"complete":{"type":"boolean"},"provenance_digest":{"$ref":"#/$defs/digest"}}},
    "page":{"type":"object","additionalProperties":false,"required":["schema_version","contract_version","query_id","attempt_id","page_number","rows","next_page","result_digest","completeness","statistics","provenance_digest"],"properties":{"schema_version":{"const":"coh.query-page/v1"},"contract_version":{"const":"1.0.0"},"query_id":{"$ref":"#/$defs/uuid_v7"},"attempt_id":{"$ref":"#/$defs/uuid_v7"},"page_number":{"type":"integer","minimum":1},"rows":{"type":"array","maxItems":100000,"items":{"type":"object"}},"next_page":{"$ref":"#/$defs/nullable_handle"},"result_digest":{"$ref":"#/$defs/digest"},"completeness":{"$ref":"#/$defs/completeness"},"statistics":{"$ref":"#/$defs/statistics"},"provenance_digest":{"$ref":"#/$defs/digest"}}},
    "poll":{"type":"object","additionalProperties":false,"required":["schema_version","contract_version","query_id","attempt_id","outcome","page","statistics","completeness","provenance_digest"],"properties":{"schema_version":{"const":"coh.query-poll/v1"},"contract_version":{"const":"1.0.0"},"query_id":{"$ref":"#/$defs/uuid_v7"},"attempt_id":{"$ref":"#/$defs/uuid_v7"},"outcome":{"enum":["running","completed","partial","canceled","failed"]},"page":{"oneOf":[{"$ref":"#/$defs/page"},{"type":"null"}]},"statistics":{"$ref":"#/$defs/statistics"},"completeness":{"$ref":"#/$defs/completeness"},"provenance_digest":{"$ref":"#/$defs/digest"}}},
    "cancellation":{"type":"object","additionalProperties":false,"required":["schema_version","contract_version","query_id","attempt_id","outcome","requested_at","confirmed_at","provenance_digest"],"properties":{"schema_version":{"const":"coh.query-cancellation/v1"},"contract_version":{"const":"1.0.0"},"query_id":{"$ref":"#/$defs/uuid_v7"},"attempt_id":{"$ref":"#/$defs/uuid_v7"},"outcome":{"enum":["requested","confirmed","uncertain"]},"requested_at":{"$ref":"#/$defs/timestamp"},"confirmed_at":{"oneOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},"provenance_digest":{"$ref":"#/$defs/digest"}}}
  }
}
