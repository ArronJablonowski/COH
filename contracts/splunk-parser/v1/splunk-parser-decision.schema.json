{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coh.invalid/contracts/splunk-parser/v1/splunk-parser-decision.schema.json","title":"COH Splunk parser policy decision","type":"object","additionalProperties":false,
  "required":["schema_version","contract_version","decision_id","query_id","outcome","reason_codes","validator_version","actor_id","scope_digest","query_digest","capability_digest","schema_digest","plan_digest","registry_digest","parser_receipt_digest","policy_decision_digest","audit_reservation_digest","observed_at","valid_until","digest"],
  "properties":{"schema_version":{"const":"coh.splunk-parser-decision/v1"},"contract_version":{"const":"1.0.0"},"decision_id":{"$ref":"#/$defs/id"},"query_id":{"$ref":"#/$defs/id"},"outcome":{"enum":["accepted","denied"]},"reason_codes":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"}},"validator_version":{"const":"splunk-parser-1.0.0"},"actor_id":{"$ref":"#/$defs/id"},"scope_digest":{"$ref":"#/$defs/digest"},"query_digest":{"$ref":"#/$defs/digest"},"capability_digest":{"$ref":"#/$defs/digest"},"schema_digest":{"$ref":"#/$defs/digest"},"plan_digest":{"$ref":"#/$defs/digest"},"registry_digest":{"$ref":"#/$defs/digest"},"parser_receipt_digest":{"$ref":"#/$defs/digest"},"policy_decision_digest":{"$ref":"#/$defs/digest"},"audit_reservation_digest":{"$ref":"#/$defs/digest"},"observed_at":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"digest":{"$ref":"#/$defs/digest"}},
  "$defs":{"id":{"type":"string","pattern":"^[0-9a-f-]{36}$"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
