{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coh.invalid/contracts/splunk-parser/v1/splunk-parser-revocation.schema.json","title":"COH Splunk parser revocation evidence","type":"object","additionalProperties":false,
