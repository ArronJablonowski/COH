{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coh.invalid/contracts/splunk-parser/v1/splunk-parser-definition.schema.json","title":"COH Splunk parser definition","type":"object","additionalProperties":false,
  "required":["schema_version","contract_version","validator_version","source_id","resources","fields","default_projection","stable_sort","timestamp_field","tenant_field","source_field","hard_maximum_rows"],
  "properties":{
    "schema_version":{"const":"coh.splunk-parser-definition/v1"},"contract_version":{"const":"1.0.0"},"validator_version":{"const":"splunk-parser-1.0.0"},"source_id":{"$ref":"#/$defs/name"},
    "resources":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["id","vendor_index"],"properties":{"id":{"$ref":"#/$defs/name"},"vendor_index":{"type":"string"}}}},
    "fields":{"type":"array","minItems":1,"maxItems":4096,"items":{"type":"object","additionalProperties":false,"required":["name","vendor_name","type","projectable","filterable","sortable","aggregatable"],"properties":{"name":{"$ref":"#/$defs/name"},"vendor_name":{"type":"string"},"type":{"enum":["string","integer","boolean","timestamp","ip","bytes"]},"projectable":{"type":"boolean"},"filterable":{"type":"boolean"},"sortable":{"type":"boolean"},"aggregatable":{"type":"boolean"}}}},
    "default_projection":{"$ref":"#/$defs/names"},"stable_sort":{"type":"array","minItems":1,"maxItems":8,"items":{"$ref":"#/$defs/sort"}},"timestamp_field":{"$ref":"#/$defs/name"},"tenant_field":{"type":"string"},"source_field":{"type":"string"},"hard_maximum_rows":{"type":"integer","minimum":1,"maximum":100000}
  },
  "$defs":{"name":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},"names":{"type":"array","minItems":1,"maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/name"}},"sort":{"type":"object","additionalProperties":false,"required":["name","direction"],"properties":{"name":{"$ref":"#/$defs/name"},"direction":{"enum":["asc","desc"]}}}}
}
