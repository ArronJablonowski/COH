{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coh.invalid/contracts/splunk-parser/v1/splunk-plan.schema.json","title":"COH bounded Splunk plan","type":"object","additionalProperties":false,
  "required":["schema_version","contract_version","validator_version","query_id","source_id","resource_ids","canonical_spl","columns","aggregations","sort","earliest","latest","maximum_rows","maximum_bytes","maximum_duration_millis","subsearch_count","command_count","query_digest","capability_digest","schema_digest","authority","registry_digest","mandatory_filter_digest","plan_digest"],
  "properties":{
    "schema_version":{"const":"coh.splunk-plan/v1"},"contract_version":{"const":"1.0.0"},"validator_version":{"const":"splunk-parser-1.0.0"},"query_id":{"$ref":"#/$defs/id"},"source_id":{"$ref":"#/$defs/name"},"resource_ids":{"type":"array","minItems":1,"maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/name"}},"canonical_spl":{"type":"string","minLength":1,"maxLength":65536},
    "columns":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["logical_name","vendor_name","type","nullable"],"properties":{"logical_name":{"$ref":"#/$defs/name"},"vendor_name":{"type":"string"},"type":{"enum":["string","integer","boolean","timestamp","ip","bytes"]},"nullable":{"type":"boolean"}}}},
    "aggregations":{"type":"array","maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["function","input_logical","input_vendor","output_name","output_type"],"properties":{"function":{"enum":["avg","count","dc","max","min","sum"]},"input_logical":{"type":"string"},"input_vendor":{"type":"string"},"output_name":{"$ref":"#/$defs/name"},"output_type":{"enum":["string","integer","boolean","timestamp","ip","bytes"]}}}},
    "sort":{"type":"array","maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["name","direction"],"properties":{"name":{"$ref":"#/$defs/name"},"direction":{"enum":["asc","desc"]}}}},
    "earliest":{"type":"string","format":"date-time"},"latest":{"type":"string","format":"date-time"},
    "maximum_rows":{"type":"integer","minimum":1,"maximum":100000},"maximum_bytes":{"type":"integer","minimum":1,"maximum":1048576},"maximum_duration_millis":{"type":"integer","minimum":1,"maximum":120000},"subsearch_count":{"type":"integer","minimum":0,"maximum":4},"command_count":{"type":"integer","minimum":1,"maximum":40},
    "query_digest":{"$ref":"#/$defs/digest"},"capability_digest":{"$ref":"#/$defs/digest"},"schema_digest":{"$ref":"#/$defs/digest"},"authority":{"type":"object","additionalProperties":false,"required":["actor_id","authorization_digest","policy_decision_digest","audit_reservation_digest"],"properties":{"actor_id":{"$ref":"#/$defs/id"},"authorization_digest":{"$ref":"#/$defs/digest"},"policy_decision_digest":{"$ref":"#/$defs/digest"},"audit_reservation_digest":{"$ref":"#/$defs/digest"}}},"registry_digest":{"$ref":"#/$defs/digest"},"mandatory_filter_digest":{"$ref":"#/$defs/digest"},"plan_digest":{"$ref":"#/$defs/digest"}
  },
  "$defs":{"name":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},"id":{"type":"string","pattern":"^[0-9a-f-]{36}$"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
}
