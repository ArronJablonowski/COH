{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/file-size/v1/file-size-policy.schema.json",
  "title": "COH file-size policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "thresholds", "exceptions"],
  "properties": {
    "schema_version": {"const": "coh.file-size-policy/v1"},
    "policy_version": {"const": "1.0.0"},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warning_physical_lines",
        "hard_physical_lines",
        "script_physical_lines",
        "normal_minimum_lines",
        "normal_maximum_lines"
      ],
      "properties": {
        "warning_physical_lines": {"const": 500},
        "hard_physical_lines": {"const": 800},
        "script_physical_lines": {"const": 300},
        "normal_minimum_lines": {"const": 150},
        "normal_maximum_lines": {"const": 400}
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/exception"}
    }
  },
  "$defs": {
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "category",
        "owner",
        "justification",
        "expires_on",
        "tracking_issue",
        "content_sha256",
        "approved_max_physical_lines"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\*?\\[\\]\\r\\n]+(?:/[^/\\\\*?\\[\\]\\r\\n]+)*$"},
        "category": {"enum": ["generated", "vendor", "schema", "migration_data", "large_fixture", "script"]},
        "owner": {"type": "string", "minLength": 2, "maxLength": 128},
        "justification": {"type": "string", "minLength": 20, "maxLength": 512},
        "expires_on": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "tracking_issue": {"type": "string", "pattern": "^CYB-[1-9][0-9]*$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved_max_physical_lines": {"type": "integer", "minimum": 301, "maximum": 1000000},
        "generator": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "allOf": [
        {
          "if": {"properties": {"category": {"const": "script"}}},
          "then": {"properties": {"approved_max_physical_lines": {"maximum": 800}}},
          "else": {"required": ["generator"], "properties": {"approved_max_physical_lines": {"minimum": 801}}}
        }
      ]
    }
  }
}
