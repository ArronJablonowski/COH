{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/sentinel-query/v1/sentinel-query-contracts.schema.json",
  "title": "COH Sentinel bounded query contracts v1",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "vendorName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{9}Z$"},
    "timeRange": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"$ref": "#/$defs/timestamp"}, "end": {"$ref": "#/$defs/timestamp"}}
    },
    "stableKey": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_id", "timestamp_column", "columns"],
      "properties": {
        "resource_id": {"$ref": "#/$defs/token"},
        "timestamp_column": {"$ref": "#/$defs/vendorName"},
        "columns": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/vendorName"}}
      }
    },
    "runtimeConfig": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "contract_version", "discovery_config_digest", "minimum_slice_duration_millis", "split_threshold_rows", "split_threshold_bytes", "maximum_response_bytes", "stable_keys", "digest"],
      "properties": {
        "schema_version": {"const": "coh.sentinel-query-runtime-config/v1"}, "contract_version": {"const": "1.0.0"},
        "discovery_config_digest": {"$ref": "#/$defs/digest"},
        "minimum_slice_duration_millis": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "split_threshold_rows": {"type": "integer", "minimum": 1, "maximum": 100000},
        "split_threshold_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "maximum_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "stable_keys": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/stableKey"}},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "queryRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "contract_version", "operation", "query_id", "attempt_id", "slice_number", "source_id", "workspace_id", "scope_digest", "authority_digest", "capability_digest", "schema_digest", "qualification_digest", "common_query_digest", "validation_digest", "canonical_kql", "canonical_kql_digest", "policy_decision_digest", "audit_record_digest", "time_range", "maximum_rows", "maximum_bytes", "server_wait_seconds", "transport_identity_digest", "request_digest"],
      "properties": {
        "schema_version": {"const": "coh.sentinel-query-request/v1"}, "contract_version": {"const": "1.0.0"}, "operation": {"const": "sentinel.query.post"},
        "query_id": {"$ref": "#/$defs/uuid7"}, "attempt_id": {"$ref": "#/$defs/uuid7"}, "slice_number": {"type": "integer", "minimum": 1, "maximum": 1000},
        "source_id": {"$ref": "#/$defs/token"}, "workspace_id": {"$ref": "#/$defs/uuid"},
        "scope_digest": {"$ref": "#/$defs/digest"}, "authority_digest": {"$ref": "#/$defs/digest"}, "capability_digest": {"$ref": "#/$defs/digest"},
        "schema_digest": {"$ref": "#/$defs/digest"}, "qualification_digest": {"$ref": "#/$defs/digest"}, "common_query_digest": {"$ref": "#/$defs/digest"},
        "validation_digest": {"$ref": "#/$defs/digest"}, "canonical_kql": {"type": "string", "minLength": 1, "maxLength": 131072},
        "canonical_kql_digest": {"$ref": "#/$defs/digest"}, "policy_decision_digest": {"$ref": "#/$defs/digest"}, "audit_record_digest": {"$ref": "#/$defs/digest"},
        "time_range": {"$ref": "#/$defs/timeRange"}, "maximum_rows": {"type": "integer", "minimum": 1, "maximum": 100000},
        "maximum_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576}, "server_wait_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "transport_identity_digest": {"$ref": "#/$defs/digest"}, "request_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "column": {
      "type": "object", "additionalProperties": false, "required": ["name", "type"],
      "properties": {"name": {"$ref": "#/$defs/vendorName"}, "type": {"enum": ["bool", "datetime", "decimal", "guid", "int", "long", "real", "string", "timespan"]}}
    },
    "table": {
      "type": "object", "additionalProperties": false, "required": ["name", "columns", "rows"],
      "properties": {
        "name": {"const": "PrimaryResult"}, "columns": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/column"}},
        "rows": {"type": "array", "maxItems": 100000, "items": {"type": "array", "maxItems": 256}}
      }
    },
    "statistics": {
      "type": "object", "additionalProperties": false, "required": ["rows_scanned", "rows_returned", "bytes_returned", "duration_millis", "resource_usage_digest"],
      "properties": {
        "rows_scanned": {"type": "integer", "minimum": 0}, "rows_returned": {"type": "integer", "minimum": 0}, "bytes_returned": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "duration_millis": {"type": "integer", "minimum": 0, "maximum": 600000}, "resource_usage_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "detail_codes", "message_digest"],
      "properties": {"code": {"const": "PartialError"}, "detail_codes": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}, "message_digest": {"$ref": "#/$defs/digest"}}
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "http_status", "request_digest", "vendor_response_digest", "lease_decision_digest", "transport_digest", "transport_identity_digest"],
      "properties": {
        "operation": {"const": "sentinel.query.post"}, "http_status": {"const": 200}, "request_digest": {"$ref": "#/$defs/digest"}, "vendor_response_digest": {"$ref": "#/$defs/digest"},
        "lease_decision_digest": {"$ref": "#/$defs/digest"}, "transport_digest": {"$ref": "#/$defs/digest"}, "transport_identity_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "queryResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "contract_version", "request_digest", "tables", "statistics", "error", "receipt", "response_digest"],
      "properties": {
        "schema_version": {"const": "coh.sentinel-query-response/v1"}, "contract_version": {"const": "1.0.0"}, "request_digest": {"$ref": "#/$defs/digest"},
        "tables": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/table"}}, "statistics": {"$ref": "#/$defs/statistics"},
        "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]}, "receipt": {"$ref": "#/$defs/receipt"}, "response_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "slice": {
      "type": "object", "additionalProperties": false, "required": ["number", "parent", "time_range", "state", "request_digest", "response_digest"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 1000}, "parent": {"type": "integer", "minimum": 0, "maximum": 999}, "time_range": {"$ref": "#/$defs/timeRange"},
        "state": {"enum": ["planned", "split", "complete", "denied", "canceled", "unknown"]}, "request_digest": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"},
        "response_digest": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"}
      }
    },
    "slicePlan": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "contract_version", "query_id", "attempt_id", "original_time_range", "maximum_slices", "minimum_duration_millis", "split_threshold_rows", "split_threshold_bytes", "slices", "plan_digest"],
      "properties": {
        "schema_version": {"const": "coh.sentinel-slice-plan/v1"}, "contract_version": {"const": "1.0.0"}, "query_id": {"$ref": "#/$defs/uuid7"}, "attempt_id": {"$ref": "#/$defs/uuid7"},
        "original_time_range": {"$ref": "#/$defs/timeRange"}, "maximum_slices": {"type": "integer", "minimum": 1, "maximum": 1000},
        "minimum_duration_millis": {"type": "integer", "minimum": 1, "maximum": 86400000}, "split_threshold_rows": {"type": "integer", "minimum": 1, "maximum": 100000},
        "split_threshold_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576}, "slices": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/slice"}},
        "plan_digest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/runtimeConfig"}, {"$ref": "#/$defs/queryRequest"}, {"$ref": "#/$defs/queryResponse"}, {"$ref": "#/$defs/slicePlan"}
  ]
}
