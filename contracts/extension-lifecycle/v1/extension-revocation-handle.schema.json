{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/extension-lifecycle/v1/extension-revocation-handle.schema.json",
  "title": "COH owner-bound data-only extension revocation handle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "handle_id", "extension_id", "manifest_digest", "transition_id", "registration_id", "registration_ordinal", "organization_id", "tenant_id", "scope_digest", "registry_revision", "generation", "issued_at", "handle_digest"],
  "properties": {
    "schema_version": {"const": "coh.extension-revocation-handle/v1"},
    "contract_version": {"const": "1.0.0"},
    "handle_id": {"$ref": "#/$defs/uuid7"},
    "extension_id": {"$ref": "#/$defs/uuid7"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "transition_id": {"$ref": "#/$defs/uuid7"},
    "registration_id": {"$ref": "#/$defs/token"},
    "registration_ordinal": {"type": "integer", "minimum": 0, "maximum": 63},
    "organization_id": {"$ref": "#/$defs/uuid7"},
    "tenant_id": {"$ref": "#/$defs/uuid7"},
    "scope_digest": {"$ref": "#/$defs/digest"},
    "registry_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "handle_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
