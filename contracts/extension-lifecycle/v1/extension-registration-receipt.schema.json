{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/extension-lifecycle/v1/extension-registration-receipt.schema.json",
  "title": "COH durable extension registration receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "receipt_id", "idempotency_key", "extension_id", "manifest_digest", "transition_id", "registration_id", "registration_ordinal", "role", "capability_id", "capability_version", "provider_id", "organization_id", "tenant_id", "scope_digest", "permissions_digest", "resource_limits_digest", "registry_revision", "generation", "state", "revocation_handle", "registered_at", "revoked_at", "effect_audit_digest", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "coh.extension-registration-receipt/v1"},
    "contract_version": {"const": "1.0.0"},
    "receipt_id": {"$ref": "#/$defs/uuid7"},
    "idempotency_key": {"$ref": "#/$defs/uuid7"},
    "extension_id": {"$ref": "#/$defs/uuid7"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "transition_id": {"$ref": "#/$defs/uuid7"},
    "registration_id": {"$ref": "#/$defs/token"},
    "registration_ordinal": {"type": "integer", "minimum": 0, "maximum": 63},
    "role": {"enum": ["consumer", "provider"]},
    "capability_id": {"$ref": "#/$defs/token"},
    "capability_version": {"$ref": "#/$defs/semver"},
    "provider_id": {"$ref": "#/$defs/token"},
    "organization_id": {"$ref": "#/$defs/uuid7"},
    "tenant_id": {"$ref": "#/$defs/uuid7"},
    "scope_digest": {"$ref": "#/$defs/digest"},
    "permissions_digest": {"$ref": "#/$defs/digest"},
    "resource_limits_digest": {"$ref": "#/$defs/digest"},
    "registry_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "state": {"enum": ["registered", "revoked"]},
    "revocation_handle": {"$ref": "extension-revocation-handle.schema.json"},
    "registered_at": {"$ref": "#/$defs/timestamp"},
    "revoked_at": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/timestamp"}]},
    "effect_audit_digest": {"$ref": "#/$defs/digest"},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)(-[0-9A-Za-z-]+([.][0-9A-Za-z-]+)*)?([+][0-9A-Za-z-]+([.][0-9A-Za-z-]+)*)?$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
