{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/extension-lifecycle/v1/active-extension.schema.json",
  "title": "COH atomically published active extension pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "extension_id", "extension_name", "extension_version", "manifest_digest", "transition_id", "lifecycle_revision", "registry_revision", "organization_id", "tenant_id", "active_profile_revision", "profile_binding_digest", "composition_digest", "capability_graph_digest", "registration_receipt_digests", "activation_audit_digest", "activated_at", "active_digest"],
  "properties": {
    "schema_version": {"const": "coh.active-extension/v1"},
    "contract_version": {"const": "1.0.0"},
    "extension_id": {"$ref": "#/$defs/uuid7"},
    "extension_name": {"$ref": "#/$defs/token"},
    "extension_version": {"$ref": "#/$defs/semver"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "transition_id": {"$ref": "#/$defs/uuid7"},
    "lifecycle_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "registry_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "organization_id": {"$ref": "#/$defs/uuid7"},
    "tenant_id": {"$ref": "#/$defs/uuid7"},
    "active_profile_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "profile_binding_digest": {"$ref": "#/$defs/digest"},
    "composition_digest": {"$ref": "#/$defs/digest"},
    "capability_graph_digest": {"$ref": "#/$defs/digest"},
    "registration_receipt_digests": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/digest"}},
    "activation_audit_digest": {"$ref": "#/$defs/digest"},
    "activated_at": {"$ref": "#/$defs/timestamp"},
    "active_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)(-[0-9A-Za-z-]+([.][0-9A-Za-z-]+)*)?([+][0-9A-Za-z-]+([.][0-9A-Za-z-]+)*)?$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
