{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.local/contracts/policy/v1/opa-policy-bundle.schema.json",
  "title": "COH OPA policy bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "bundle_id", "organization_id", "tenant_id", "policy_revision", "entrypoint", "valid_from", "valid_until", "modules", "data"],
  "properties": {
    "schema_version": {"const": "coh.opa-policy-bundle/v1"},
    "contract_version": {"const": "1.0.0"},
    "bundle_id": {"$ref": "#/$defs/uuidv7"},
    "organization_id": {"$ref": "#/$defs/uuidv7"},
    "tenant_id": {"$ref": "#/$defs/uuidv7"},
    "policy_revision": {"type": "integer", "minimum": 1},
    "entrypoint": {"const": "data.coh.authz.decision"},
    "valid_from": {"$ref": "#/$defs/timestamp"},
    "valid_until": {"$ref": "#/$defs/timestamp"},
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "source"],
        "properties": {
          "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_./-]{0,122}\\.rego$"},
          "source": {"type": "string", "minLength": 1, "maxLength": 262144}
        }
      }
    },
    "data": {"type": "object"}
  },
  "$defs": {
    "uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"}
  }
}
