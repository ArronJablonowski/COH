{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.local/contracts/policy/v1/policy-input.schema.json",
  "title": "COH OPA evaluation input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "phase", "evaluated_at", "actor", "manifest_digest", "manifest", "runtime", "policy"],
  "properties": {
    "schema_version": {"const": "coh.policy-input/v1"},
    "evaluation_id": {"$ref": "#/$defs/uuidv7"},
    "phase": {"enum": ["intent_created", "pre_dispatch"]},
    "evaluated_at": {"$ref": "#/$defs/timestamp"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "organization_id", "tenant_id", "case_id", "revision", "roles", "permissions"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/uuidv7"},
        "organization_id": {"$ref": "#/$defs/uuidv7"},
        "tenant_id": {"$ref": "#/$defs/uuidv7"},
        "case_id": {"$ref": "#/$defs/uuidv7"},
        "revision": {"type": "integer", "minimum": 1},
        "roles": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "permissions": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}
      }
    },
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "manifest": {"$ref": "../../action/v1/action-manifest.schema.json"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_route", "validator_state", "tool_registered", "targets_authorized", "tenant_authorized", "data_route_authorized", "capability_fields_known", "emergency_stop_active"],
      "properties": {
        "data_route": {"$ref": "#/$defs/token"},
        "validator_state": {"enum": ["qualified", "stale", "failed", "unknown"]},
        "tool_registered": {"type": "boolean"},
        "targets_authorized": {"type": "boolean"},
        "tenant_authorized": {"type": "boolean"},
        "data_route_authorized": {"type": "boolean"},
        "capability_fields_known": {"type": "boolean"},
        "emergency_stop_active": {"type": "boolean"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "policy_digest", "policy_revision"],
      "properties": {
        "bundle_id": {"$ref": "#/$defs/uuidv7"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "policy_revision": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
