{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.local/contracts/policy/v1/signed-opa-policy-bundle.schema.json",
  "title": "COH signed OPA policy bundle envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "bundle", "bundle_digest", "signer_key_id", "signer_key_revision", "signature_algorithm", "signature"],
  "properties": {
    "schema_version": {"const": "coh.signed-opa-policy-bundle/v1"},
    "contract_version": {"const": "1.0.0"},
    "bundle": {"$ref": "opa-policy-bundle.schema.json"},
    "bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signer_key_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "signer_key_revision": {"type": "integer", "minimum": 1},
    "signature_algorithm": {"const": "ed25519"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  }
}
