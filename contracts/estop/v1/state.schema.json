{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/estop/v1/state.schema.json",
  "title": "COH emergency-stop state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "scope", "epoch", "active", "request_id", "request_digest", "actor_id", "actor_revision", "reason_code", "authorization_decision_digest", "policy_decision_digest", "activated_at"],
  "properties": {
    "schema_version": {"const": "coh.estop-state/v1"},
    "contract_version": {"const": "1.0.0"},
    "scope": {"$ref": "command.schema.json#/$defs/scope"},
    "epoch": {"type": "integer", "minimum": 1},
    "active": {"const": true},
    "request_id": {"$ref": "command.schema.json#/$defs/uuid7"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "actor_id": {"$ref": "command.schema.json#/$defs/uuid7"},
    "actor_revision": {"type": "integer", "minimum": 1},
    "reason_code": {"enum": ["operator_emergency", "safety_watch_expired", "runner_heartbeat_lost", "policy_emergency", "incident_containment"]},
    "authorization_decision_digest": {"$ref": "#/$defs/digest"},
    "policy_decision_digest": {"$ref": "#/$defs/digest"},
    "activated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
