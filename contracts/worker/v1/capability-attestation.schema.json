{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/worker/v1/capability-attestation.schema.json",
  "title": "COH remote-worker capability attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "scope", "worker_id", "enrollment_nonce",
    "transport_identity_digest", "certificate_fingerprint", "certificate_revision",
    "platform_os", "platform_architecture", "executor_digest", "runtime_digest",
    "tool_registry_digest", "isolation_classes", "maximum_action_tier", "resources",
    "network_modes", "issued_at", "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "coh.remote-worker-capability/v1"},
    "contract_version": {"const": "1.0.0"},
    "scope": {"$ref": "#/$defs/scope"},
    "worker_id": {"$ref": "#/$defs/token"},
    "enrollment_nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22,86}$"},
    "transport_identity_digest": {"$ref": "#/$defs/digest"},
    "certificate_fingerprint": {"$ref": "#/$defs/digest"},
    "certificate_revision": {"type": "integer", "minimum": 1},
    "platform_os": {"enum": ["linux", "darwin", "windows"]},
    "platform_architecture": {"enum": ["amd64", "arm64"]},
    "executor_digest": {"$ref": "#/$defs/digest"},
    "runtime_digest": {"$ref": "#/$defs/digest"},
    "tool_registry_digest": {"$ref": "#/$defs/digest"},
    "isolation_classes": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": {"enum": ["native_restricted", "oci_sandbox", "remote_isolated"]}
    },
    "maximum_action_tier": {"enum": ["T0", "T1", "T2", "T3"]},
    "resources": {"$ref": "#/$defs/resources"},
    "network_modes": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": {"enum": ["brokered_egress", "none"]}
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "uuid7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["organization_id", "tenant_id"],
      "properties": {"organization_id": {"$ref": "#/$defs/uuid7"}, "tenant_id": {"$ref": "#/$defs/uuid7"}}
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_time_milliseconds", "cpu_milliseconds", "memory_bytes", "output_bytes", "ephemeral_storage_bytes", "process_count", "open_file_count"],
      "properties": {
        "wall_time_milliseconds": {"type": "integer", "minimum": 1},
        "cpu_milliseconds": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1048576},
        "output_bytes": {"type": "integer", "minimum": 1},
        "ephemeral_storage_bytes": {"type": "integer", "minimum": 1},
        "process_count": {"type": "integer", "minimum": 1},
        "open_file_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
