{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coh.invalid/contracts/domain/v1/capability-risk-payloads.schema.json","title":"COH capability and risk payload schemas v1","$defs":{"model":{"type":"object","required":["provider","requested_model","actual_model","revision_digest","runtime","tokenizer_version","template_version","parser_version"],"properties":{"provider":{"$ref":"#/$defs/token"},"requested_model":{"$ref":"#/$defs/token"},"actual_model":{"$ref":"#/$defs/token"},"revision_digest":{"$ref":"#/$defs/digest"},"runtime":{"$ref":"#/$defs/token"},"tokenizer_version":{"$ref":"#/$defs/version"},"template_version":{"$ref":"#/$defs/version"},"parser_version":{"$ref":"#/$defs/version"}},"additionalProperties":false},"skill":{"type":"object","required":["name","version","content_digest","provenance_digest","capabilities","promotion_state"],"properties":{"name":{"$ref":"#/$defs/token"},"version":{"$ref":"#/$defs/version"},"content_digest":{"$ref":"#/$defs/digest"},"provenance_digest":{"$ref":"#/$defs/digest"},"capabilities":{"$ref":"#/$defs/token_set"},"promotion_state":{"enum":["draft","review","signed","qualified","promoted","revoked"]}},"additionalProperties":false},"vulnerability":{"type":"object","required":["asset_id","observation_digest","identifiers","assertion_state","priority_factors","remediation_state","retest_state"],"properties":{"asset_id":{"$ref":"#/$defs/uuid_v7"},"observation_digest":{"$ref":"#/$defs/digest"},"identifiers":{"$ref":"#/$defs/token_set"},"assertion_state":{"enum":["observed","suspected","confirmed","rejected","exploited"]},"priority_factors":{"$ref":"#/$defs/token_set"},"remediation_state":{"enum":["unassigned","planned","in_progress","exception","remediated","closed","reopened"]},"retest_state":{"enum":["not_requested","pending","passed","failed","inconclusive"]}},"additionalProperties":false},"risk":{"type":"object","required":["subject_type","subject_id","method","method_version","ordered_factors","evidence_d