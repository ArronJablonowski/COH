{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/domain/v1/common-envelope.schema.json",
  "title": "COH domain contract common envelope v1",
  "description": "Strict persistence-neutral envelope. Per-kind schemas further constrain kind, case nullability, and data.",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "id",
    "organization_id",
    "tenant_id",
    "case_id",
    "revision",
    "created_at",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "coh.domain/v1"
    },
    "kind": {
      "enum": [
        "action",
        "approval",
        "artifact_manifest",
        "case",
        "claim",
        "evidence",
        "finding",
        "model",
        "query",
        "risk",
        "roe",
        "run",
        "skill",
        "task",
        "timeline_event",
        "vulnerability"
      ]
    },
    "id": {
      "$ref": "#/$defs/uuid_v7"
    },
    "organization_id": {
      "$ref": "#/$defs/uuid_v7"
    },
    "tenant_id": {
      "$ref": "#/$defs/uuid_v7"
    },
    "case_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid_v7"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "data": {
      "type": "object",
      "maxProperties": 128
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{9}Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bounded_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
