{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/domain/v1/workflow-payloads.schema.json",
  "title": "COH durable-foundation payload schemas v1",
  "$defs": {
    "case": {
      "type": "object",
      "required": ["owner_actor_id", "classification", "state", "retention_policy_id"],
      "properties": {
        "owner_actor_id": { "$ref": "#/$defs/uuid_v7" },
        "classification": { "$ref": "#/$defs/token" },
        "state": { "enum": ["open", "closed", "archived"] },
        "retention_policy_id": { "$ref": "#/$defs/uuid_v7" },
        "legal_hold": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["initiating_actor_id", "workflow_type", "workflow_version", "policy_digest", "provider_route", "status"],
      "properties": {
        "initiating_actor_id": { "$ref": "#/$defs/uuid_v7" },
        "workflow_type": { "$ref": "#/$defs/token" },
        "workflow_version": { "$ref": "#/$defs/version" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "provider_route": { "$ref": "#/$defs/token" },
        "budget_plan_digest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["queued", "running", "waiting", "succeeded", "failed", "denied", "canceled", "cancelled", "timeout", "uncertain"] },
        "budget_units": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "contract_version": { "type": "string", "pattern": "^coh[.]agent-loop/v1$" },
        "current_step_id": { "$ref": "#/$defs/uuid_v7" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "input_refs": { "$ref": "#/$defs/digest_set" },
        "output_refs": { "$ref": "#/$defs/digest_set" },
        "provenance_digest": { "$ref": "#/$defs/digest" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["run_id", "attempt", "status", "deadline", "input_refs", "output_refs"],
      "properties": {
        "run_id": { "$ref": "#/$defs/uuid_v7" },
        "parent_task_id": { "oneOf": [{ "$ref": "#/$defs/uuid_v7" }, { "type": "null" }] },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "lease_id": { "oneOf": [{ "$ref": "#/$defs/uuid_v7" }, { "type": "null" }] },
        "status": { "enum": ["pending", "leased", "running", "dispatching", "succeeded", "failed", "denied", "canceled", "cancelled", "timeout", "uncertain"] },
        "deadline": { "$ref": "#/$defs/timestamp" },
        "input_refs": { "$ref": "#/$defs/digest_set" },
        "output_refs": { "$ref": "#/$defs/digest_set" },
        "contract_version": { "type": "string", "pattern": "^coh[.]agent-loop/v1$" },
        "activity_kind": { "enum": ["planning", "authorized_action"] },
        "intent_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "string", "maxLength": 0 }] },
        "receipt_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "string", "maxLength": 0 }] },
        "budget_reservation_digest": { "$ref": "#/$defs/digest" },
        "budget_settlement_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "string", "maxLength": 0 }] },
        "provenance_digest": { "$ref": "#/$defs/digest" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "artifact_manifest": {
      "type": "object",
      "required": ["artifact_digest", "source_digests", "collected_at", "source_time", "source_time_precision", "clock_uncertainty_ns", "transformations"],
      "properties": {
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "source_digests": { "$ref": "#/$defs/digest_set" },
        "collected_at": { "$ref": "#/$defs/timestamp" },
        "source_time": { "$ref": "#/$defs/timestamp" },
        "source_timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
        "source_time_precision": { "enum": ["nanosecond", "microsecond", "millisecond", "second", "minute", "day", "unknown"] },
        "clock_uncertainty_ns": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "transformations": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/digest" } },
        "tool_versions": { "$ref": "#/$defs/token_set" },
        "query_versions": { "$ref": "#/$defs/token_set" },
        "model_versions": { "$ref": "#/$defs/token_set" }
      },
      "additionalProperties": false
    },
    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{9}Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,8}([.][0-9]{1,9}){0,2}$"
    },
    "digest_set": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/digest" }
    },
    "token_set": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/token" }
    }
  }
}
