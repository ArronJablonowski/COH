{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/query-bounds/v1/query-bound-decision.schema.json",
  "title": "COH mandatory UTC query-bound decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "decision_digest", "query_id", "query_digest",
    "outcome", "reason_code", "organization_id", "tenant_id", "case_id", "actor_id",
    "actor_revision", "source_id", "source_revision", "allowlist_revision", "capability_digest",
    "capability_revision", "authority_digest", "resource_scope_digest", "authorization_decision_digest",
    "policy_decision_digest", "policy_revision", "approval_required", "audit_reservation_digest",
    "revocation_revision", "interval_start", "interval_end", "limits_digest", "evaluated_at", "replayed"
  ],
  "properties": {
    "schema_version": {"const": "coh.query-bound-decision/v1"},
    "contract_version": {"const": "1.0.0"},
    "decision_digest": {"$ref": "#/$defs/digest"},
    "query_id": {"$ref": "#/$defs/uuid_v7"},
    "query_digest": {"$ref": "#/$defs/digest"},
    "outcome": {"enum": ["allowed", "denied", "invalid", "unavailable"]},
    "reason_code": {"$ref": "#/$defs/reason"},
    "organization_id": {"$ref": "#/$defs/uuid_v7"},
    "tenant_id": {"$ref": "#/$defs/uuid_v7"},
    "case_id": {"$ref": "#/$defs/uuid_v7"},
    "actor_id": {"$ref": "#/$defs/uuid_v7"},
    "actor_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "source_id": {"$ref": "#/$defs/token"},
    "source_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "allowlist_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "capability_digest": {"$ref": "#/$defs/digest"},
    "capability_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "authority_digest": {"$ref": "#/$defs/digest"},
    "resource_scope_digest": {"$ref": "#/$defs/digest"},
    "authorization_decision_digest": {"$ref": "#/$defs/digest"},
    "policy_decision_digest": {"$ref": "#/$defs/digest"},
    "policy_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "approval_decision_digest": {"$ref": "#/$defs/digest"},
    "approval_required": {"type": "boolean"},
    "audit_reservation_digest": {"$ref": "#/$defs/digest"},
    "revocation_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "interval_start": {"$ref": "#/$defs/timestamp"},
    "interval_end": {"$ref": "#/$defs/timestamp"},
    "limits_digest": {"$ref": "#/$defs/digest"},
    "evaluated_at": {"$ref": "#/$defs/timestamp"},
    "replayed": {"type": "boolean"}
  },
  "$defs": {
    "uuid_v7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"}
  }
}
