{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/skill/v1/signed-skill-manifest.schema.json",
  "title": "COH publisher-signed and reviewer-signed skill envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "manifest", "manifest_digest",
    "publisher_signature", "review_signatures"
  ],
  "properties": {
    "schema_version": {"const": "coh.signed-skill-manifest/v1"},
    "contract_version": {"const": "1.0.0"},
    "manifest": {"$ref": "skill-manifest.schema.json"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "publisher_signature": {"$ref": "#/$defs/signature"},
    "review_signatures": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"$ref": "#/$defs/signature"}
    }
  },
  "$defs": {
    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id", "key_id", "key_revision", "approval_revision",
        "signature_algorithm", "signature"
      ],
      "properties": {
        "actor_id": {"$ref": "#/$defs/uuid_v7"},
        "key_id": {"$ref": "#/$defs/token"},
        "key_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "approval_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "signature_algorithm": {"const": "ed25519"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
