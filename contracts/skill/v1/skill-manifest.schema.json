{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/skill/v1/skill-manifest.schema.json",
  "title": "COH immutable reviewed skill manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "manifest_id", "skill_name", "skill_version",
    "owner_actor_id", "publisher_actor_id", "content_digest", "resources", "permissions",
    "test_suite_digest", "test_evidence_digest", "threat_model_digest",
    "previous_manifest_digest", "review_id", "review_revision", "review_decision",
    "reviewer_actor_ids", "review_evidence_digest", "reviewed_at", "valid_from", "valid_until"
  ],
  "properties": {
    "schema_version": {"const": "coh.skill-manifest/v1"},
    "contract_version": {"const": "1.0.0"},
    "manifest_id": {"$ref": "#/$defs/uuid_v7"},
    "skill_name": {"$ref": "#/$defs/token"},
    "skill_version": {"$ref": "#/$defs/version"},
    "owner_actor_id": {"$ref": "#/$defs/uuid_v7"},
    "publisher_actor_id": {"$ref": "#/$defs/uuid_v7"},
    "content_digest": {"$ref": "#/$defs/digest"},
    "resources": {
      "type": "array", "maxItems": 128,
      "items": {"$ref": "#/$defs/resource"}
    },
    "permissions": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "#/$defs/token"}
    },
    "test_suite_digest": {"$ref": "#/$defs/digest"},
    "test_evidence_digest": {"$ref": "#/$defs/digest"},
    "threat_model_digest": {"$ref": "#/$defs/digest"},
    "previous_manifest_digest": {"$ref": "#/$defs/optional_digest"},
    "review_id": {"$ref": "#/$defs/uuid_v7"},
    "review_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "review_decision": {"const": "approved"},
    "reviewer_actor_ids": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"$ref": "#/$defs/uuid_v7"}
    },
    "review_evidence_digest": {"$ref": "#/$defs/digest"},
    "reviewed_at": {"$ref": "#/$defs/timestamp"},
    "valid_from": {"$ref": "#/$defs/timestamp"},
    "valid_until": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "optional_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"const": ""}]},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[1-9][0-9]{0,8}[.][0-9]{1,9}[.][0-9]{1,9}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{9}Z$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest", "media_type", "classification", "length"],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "digest": {"$ref": "#/$defs/digest"},
        "media_type": {
          "type": "string", "minLength": 3, "maxLength": 127,
          "pattern": "^[^ /\\t\\r\\n]+/[^ /\\t\\r\\n]+$"
        },
        "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "length": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    }
  }
}
