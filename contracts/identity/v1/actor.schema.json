{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coh.invalid/contracts/identity/v1/actor.schema.json",
  "title": "COH local actor v1",
  "type": "object",
  "required": ["schema_version", "contract_version", "id", "organization_id", "name", "roles", "grants", "public_key", "revision", "active"],
  "properties": {
    "schema_version": {"const": "coh.local-identity/v1"},
    "contract_version": {"const": "1.0.0"},
    "id": {"$ref": "#/$defs/uuid_v7"},
    "organization_id": {"$ref": "#/$defs/uuid_v7"},
    "name": {"$ref": "#/$defs/token"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["administrator", "analyst", "approver", "auditor", "service"]}
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["tenant_id", "all_cases", "case_ids"],
        "properties": {
          "tenant_id": {"$ref": "#/$defs/uuid_v7"},
          "all_cases": {"type": "boolean"},
          "case_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid_v7"}}
        },
        "additionalProperties": false
      }
    },
    "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "revision": {"type": "integer", "minimum": 1},
    "active": {"type": "boolean"}
  },
  "$defs": {
    "uuid_v7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}
  },
  "additionalProperties": false
}
